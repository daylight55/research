---
import BaseLayout from '@/layouts/BaseLayout'
import TitlePage from '@/components/TitlePage'
import { getTags, localizedPath, tagSlug } from '@/utils'

const locale = 'en'
const tags = await getTags(locale)
---

<BaseLayout title='Tags' locale={locale}>
	<TitlePage title='Tags' />
	<div class='tag-index'>
		{
			tags.map((tag) => (
				<a href={localizedPath(locale, `/tags/${tagSlug(tag)}/`)} class='tag-index-link'>
					#{tag}
				</a>
			))
		}
	</div>
</BaseLayout>
