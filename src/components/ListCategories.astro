---
import { DEFAULT_LOCALE, getCategories, type Locale } from '@/utils'
import Category from '@/components/Category'

const { activeCategory, locale = DEFAULT_LOCALE } = Astro.props as {
	activeCategory?: string
	locale?: Locale
}
const categories = await getCategories(locale)
---

<div class='w-full min-w-0 max-w-full overflow-x-auto overscroll-x-contain pb-2'>
	<div class='flex w-max min-w-full flex-nowrap gap-1.5'>
		<Category locale={locale} />
		{
			categories.map((category: string) => (
				<Category name={category} activeCategory={activeCategory} locale={locale} />
			))
		}
	</div>
</div>
