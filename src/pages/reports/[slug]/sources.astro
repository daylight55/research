---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import Code from '@/components/mdx/Code'
import SourceNote from '@/components/mdx/SourceNote'
import NewsSourceCard from '@/components/mdx/NewsSourceCard'
import ArrowUpRight from '@/components/icons/ArrowUpRight'
import {
	DEFAULT_LOCALE,
	getPostLocale,
	getPostSlug,
	hasAnyArticleSourceNotes,
	withBase
} from '@/utils'

type Props = {
	post: CollectionEntry<'blog'>
	sourceNotes: CollectionEntry<'articleSourceNotes'>
	hasResearchLog: boolean
}

export async function getStaticPaths() {
	if (!hasAnyArticleSourceNotes()) return []

	const posts = (await getCollection('blog')).filter(
		(post) => getPostLocale(post) === DEFAULT_LOCALE && post.data.contentType === 'report'
	)
	const sourceEntries = (await getCollection('articleSourceNotes')).filter(
		(entry) => getPostLocale(entry) === DEFAULT_LOCALE
	)
	const sourceBySlug = new Map(sourceEntries.map((entry) => [getPostSlug(entry), entry]))
	const researchEntries = (await getCollection('articleResearch')).filter(
		(entry) => getPostLocale(entry) === DEFAULT_LOCALE
	)
	const researchSlugs = new Set(researchEntries.map((entry) => getPostSlug(entry)))

	return posts
		.map((post) => {
			const slug = getPostSlug(post)
			const sourceNotes = sourceBySlug.get(slug)
			if (!sourceNotes || post.data.draft) return null
			return {
				params: { slug },
				props: { post, sourceNotes, hasResearchLog: researchSlugs.has(slug) }
			}
		})
		.filter((path): path is { params: { slug: string }; props: Props } => path !== null)
}

const { post, sourceNotes, hasResearchLog } = Astro.props
const postSlug = getPostSlug(post)
const { Content } = await render(sourceNotes)
const title = sourceNotes.data.title ?? `${post.data.title}の調査素材`
---

<BaseLayout title={title} description={post.data.description} image={post.data.heroImage?.src}>
	<article class='mx-auto grid max-w-6xl gap-8 py-4'>
		<header class='research-hero grid gap-6 rounded-lg px-5 py-6 shadow-sm sm:px-8 sm:py-8'>
			<div class='flex flex-wrap gap-3'>
				<a
					href={withBase(`/reports/${postSlug}/`)}
					class='inline-flex w-fit items-center gap-2 rounded-full border border-black/10 bg-white/75 px-3 py-1.5 text-sm font-semibold text-gray-800 transition hover:border-indigo-300 hover:text-indigo-700 dark:border-white/10 dark:bg-white/10 dark:text-gray-200 dark:hover:border-indigo-300 dark:hover:text-indigo-200 [&_svg]:h-4 [&_svg]:w-4'
				>
					<ArrowUpRight />
					記事本文へ戻る
				</a>
				{
					hasResearchLog && (
						<a
							href={withBase(`/reports/${postSlug}/research/`)}
							class='inline-flex w-fit items-center gap-2 rounded-full border border-black/10 bg-white/75 px-3 py-1.5 text-sm font-semibold text-gray-800 transition hover:border-indigo-300 hover:text-indigo-700 dark:border-white/10 dark:bg-white/10 dark:text-gray-200 dark:hover:border-indigo-300 dark:hover:text-indigo-200 [&_svg]:h-4 [&_svg]:w-4'
						>
							<ArrowUpRight />
							調査ログへ
						</a>
					)
				}
			</div>
			<div class='grid gap-2'>
				<p
					class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
				>
					Source Notes
				</p>
				<h1
					class='text-3xl font-semibold leading-tight text-gray-950 dark:text-gray-50 md:text-5xl'
				>
					{title}
				</h1>
				<p class='max-w-4xl leading-7 text-gray-700 dark:text-gray-300'>
					記事本文に編集する前の調査素材、根拠リンク、論点整理、採否判断を読みやすい形に整えるための中間ノートです。
				</p>
			</div>
		</header>

		<div
			class='prose prose-base max-w-none rounded-lg border border-black/10 bg-white/85 px-5 py-6 dark:border-white/10 dark:bg-white/5 dark:prose-invert sm:px-8 md:prose-lg prose-h2:border-t prose-h2:border-black/10 prose-h2:pt-7 prose-h2:first:border-t-0 prose-h2:first:pt-0 prose-p:leading-8 prose-li:leading-8 prose-table:text-sm dark:prose-h2:border-white/10'
		>
			<Content components={{ pre: Code, SourceNote, NewsSourceCard }} />
		</div>
	</article>
</BaseLayout>
