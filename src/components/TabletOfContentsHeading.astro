---
type Heading = { depth: number; text: string; slug: string; subheadings: Heading[] }
export interface Props {
	heading: Heading
}
const { heading } = Astro.props
---

<li>
	<a href={'#' + heading.slug} data-toc-link>{heading.text}</a>
	{
		heading.subheadings.length > 0 && (
			<ul>
				{heading.subheadings.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ul>
		)
	}
</li>
