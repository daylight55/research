---
import { existsSync, readFileSync } from 'node:fs'
import { join } from 'node:path'
import { stripLocaleFromPath, type Locale } from '@/utils'

const currentContentPath = stripLocaleFromPath(Astro.url.pathname)
const articleMatch = currentContentPath.match(/^\/(news|reports)\/([^/]+)\/?$/)
const articleType = articleMatch?.[1] === 'reports' ? 'report' : articleMatch?.[1]
const articleSlug = articleMatch?.[2]
const articleRoot =
	articleType && articleSlug ? join(process.cwd(), 'articles', articleType, articleSlug) : undefined
const hasEnglishArticle = articleRoot ? existsSync(join(articleRoot, 'en', 'index.mdx')) : true
const hasMixedArticle =
	Boolean(articleRoot) && hasEnglishArticle && existsSync(join(articleRoot, 'mix-alignment.json'))
const localeScrollAlignmentPath = articleRoot ? join(articleRoot, 'mix-alignment.json') : undefined
const localeScrollAlignment =
	localeScrollAlignmentPath && existsSync(localeScrollAlignmentPath)
		? JSON.parse(readFileSync(localeScrollAlignmentPath, 'utf8'))
		: undefined
const availableLocalesForCurrentPath = [
	'ja',
	hasEnglishArticle && 'en',
	hasMixedArticle && 'mix'
].filter(Boolean) as Locale[]
const localeAvailabilityScript = `window.__localeAvailability=${JSON.stringify({
	contentPath: currentContentPath,
	availableLocales: availableLocalesForCurrentPath
})};`
const localeScrollAlignmentScript = localeScrollAlignment
	? `window.__localeScrollAlignment=${JSON.stringify({
			contentPath: currentContentPath,
			alignment: localeScrollAlignment
		}).replace(/</g, '\\u003c')};`
	: undefined
---

<script is:inline set:html={localeAvailabilityScript} />
{localeScrollAlignmentScript && <script is:inline set:html={localeScrollAlignmentScript} />}

<script>
	import { navigate } from 'astro:transitions/client'

	const basePath = import.meta.env.BASE_URL ?? '/'
	const STORAGE_KEY = 'preferredLocale'
	const SCROLL_KEY = 'localeSwitchScroll'
	const DEFAULT_LOCALE = 'ja'
	const SUPPORTED_LOCALES = ['ja', 'en', 'mix']
	const SWIPE_MAX_WIDTH = 768
	const SWIPE_MIN_DISTANCE = 72
	const SWIPE_MAX_VERTICAL_DISTANCE = 70
	const ARTICLE_BLOCK_SELECTOR = 'h1, h2, h3, h4, p, li, blockquote, table'
	const ARTICLE_VIEWPORT_ANCHOR_RATIO = 0.42
	const CURRENT_CONTENT_PATH = window.__localeAvailability?.contentPath ?? '/'
	const AVAILABLE_LOCALES_FOR_CURRENT_PATH =
		window.__localeAvailability?.availableLocales ?? SUPPORTED_LOCALES
	let pendingScrollRestore = null
	let scrollRestoreRun = 0
	let scrollRestoreTimers = []
	let swipeStart = null

	const normalizeBase = (value) => {
		if (!value || value === '/') return ''
		return value.endsWith('/') ? value.slice(0, -1) : value
	}

	const base = normalizeBase(basePath)

	const withoutBase = (pathname) => {
		if (!base) return pathname
		if (pathname === base) return '/'
		return pathname.startsWith(`${base}/`) ? pathname.slice(base.length) : pathname
	}

	const withBase = (pathname) => `${base}${pathname}` || '/'

	const normalizePath = (pathname) => {
		const normalized = pathname.startsWith('/') ? pathname : `/${pathname}`
		return normalized.endsWith('/') ? normalized : `${normalized}/`
	}

	const getPathLocale = (pathname) => {
		const normalized = normalizePath(withoutBase(pathname))
		if (normalized === '/mix/' || normalized.startsWith('/mix/')) return 'mix'
		return normalized === '/en/' || normalized.startsWith('/en/') ? 'en' : DEFAULT_LOCALE
	}

	const stripLocale = (pathname) => {
		const normalized = normalizePath(withoutBase(pathname))
		return normalized === '/en/' ? '/' : normalized.replace(/^\/en\//, '/').replace(/^\/mix\//, '/')
	}

	const getStoredLocale = () => {
		try {
			const stored = window.localStorage.getItem(STORAGE_KEY)
			return SUPPORTED_LOCALES.includes(stored) ? stored : undefined
		} catch {
			return undefined
		}
	}

	const setStoredLocale = (locale) => {
		if (!SUPPORTED_LOCALES.includes(locale)) return

		try {
			window.localStorage.setItem(STORAGE_KEY, locale)
		} catch {
			// Ignore unavailable storage and keep language selection URL-based.
		}
	}

	const canRedirectToEnglish = (contentPath) => {
		if (
			normalizePath(contentPath) === normalizePath(CURRENT_CONTENT_PATH) &&
			!AVAILABLE_LOCALES_FOR_CURRENT_PATH.includes('en')
		) {
			return false
		}
		if (contentPath === '/') return true
		if (['/news/', '/reports/', '/reference/', '/tags/'].includes(contentPath)) return true
		return (
			contentPath.startsWith('/post/') ||
			contentPath.startsWith('/news/') ||
			contentPath.startsWith('/reports/') ||
			contentPath.startsWith('/category/') ||
			contentPath.startsWith('/tags/')
		)
	}

	const canRedirectToMixedArticle = (contentPath) => {
		if (
			normalizePath(contentPath) === normalizePath(CURRENT_CONTENT_PATH) &&
			!AVAILABLE_LOCALES_FOR_CURRENT_PATH.includes('mix')
		) {
			return false
		}
		return /^\/(news|reports)\/[^/]+\/$/.test(normalizePath(contentPath))
	}

	const canRedirectToLocale = (locale, contentPath) =>
		locale === 'mix' ? canRedirectToMixedArticle(contentPath) : canRedirectToEnglish(contentPath)

	const localizedPath = (locale, contentPath) => {
		const normalized = normalizePath(contentPath)
		return locale === DEFAULT_LOCALE ? normalized : `/${locale}${normalized}`
	}

	const availableLocalesForPath = (contentPath) =>
		normalizePath(contentPath) === normalizePath(CURRENT_CONTENT_PATH)
			? AVAILABLE_LOCALES_FOR_CURRENT_PATH
			: canRedirectToMixedArticle(contentPath)
				? SUPPORTED_LOCALES
				: ['ja', 'en']

	const isMobileSwipeWidth = () =>
		window.matchMedia?.(`(max-width: ${SWIPE_MAX_WIDTH}px)`).matches ??
		window.innerWidth <= SWIPE_MAX_WIDTH

	const isSwipeIgnoredTarget = (target) =>
		target instanceof Element &&
		Boolean(
			target.closest(
				'a, button, input, textarea, select, summary, [role="button"], [data-locale-switch], pre, code'
			)
		)

	const buildLocaleTarget = (locale, contentPath) => {
		const targetPath = withBase(localizedPath(locale, contentPath))
		return `${targetPath}${window.location.search}${window.location.hash}`
	}

	const switchLocale = (targetLocale, targetHref) => {
		setStoredLocale(targetLocale)

		const targetUrl = new URL(targetHref, window.location.href)
		if (targetUrl.href === window.location.href) return

		saveScrollPosition(targetLocale)
		return Promise.resolve(navigate(targetUrl.href)).then(() => {
			restoreScrollPosition()
			window.setTimeout(restoreScrollPosition, 0)
		})
	}

	const switchLocaleBySwipe = (direction) => {
		const contentPath = stripLocale(window.location.pathname)
		const availableLocales = availableLocalesForPath(contentPath)
		const currentLocale = getPathLocale(window.location.pathname)
		const currentIndex = availableLocales.indexOf(currentLocale)
		if (currentIndex === -1) return

		const targetIndex = currentIndex + direction
		const targetLocale = availableLocales[targetIndex]
		if (!targetLocale || !canRedirectToLocale(targetLocale, contentPath)) return

		const targetHref = buildLocaleTarget(targetLocale, contentPath)
		switchLocale(targetLocale, targetHref)
	}

	const getScrollableHeight = () =>
		Math.max(
			document.documentElement.scrollHeight,
			document.body?.scrollHeight ?? 0,
			document.documentElement.clientHeight
		)

	const clamp = (value, min, max) => Math.min(max, Math.max(min, value))

	const normalizeScrollAnchorText = (text) =>
		(text ?? '')
			.replace(/[“”]/g, '"')
			.replace(/[‘’]/g, "'")
			.replace(/[`*]/g, '')
			.replace(/\s+/g, ' ')
			.trim()

	const getArticleContentRoot = () =>
		document.querySelector('article [data-mixed-english]') ??
		document.querySelector('article .prose') ??
		document.querySelector('article')

	const cloneBlockForAnchorText = (block) => {
		const clone = block.cloneNode(true)
		clone
			.querySelectorAll('.source-note, [role="note"], .not-prose')
			.forEach((node) => node.remove())
		return clone
	}

	const getComparableBlockText = (block) =>
		normalizeScrollAnchorText(cloneBlockForAnchorText(block).textContent)

	const getArticleBlocks = () => {
		const root = getArticleContentRoot()
		if (!root) return []

		return [...root.querySelectorAll(ARTICLE_BLOCK_SELECTOR)].filter((block) => {
			if (
				block.closest('.not-prose, [hidden], [data-mixed-japanese], .source-note, [role="note"]')
			) {
				return false
			}

			const rect = block.getBoundingClientRect()
			return rect.height > 0 && getComparableBlockText(block).length > 0
		})
	}

	const alignmentPairsFromData = (alignment) => {
		if (!alignment || typeof alignment !== 'object') return []
		const topLevelPairs = Array.isArray(alignment.pairs) ? alignment.pairs : []
		const sectionPairs = Array.isArray(alignment.sections)
			? alignment.sections.flatMap((section) => (Array.isArray(section.pairs) ? section.pairs : []))
			: []
		const headingPairs = Array.isArray(alignment.sections)
			? alignment.sections
					.map((section) => section?.heading)
					.filter((heading) => typeof heading?.en === 'string' && typeof heading?.ja === 'string')
			: []

		return [...headingPairs, ...topLevelPairs, ...sectionPairs]
			.filter((pair) => typeof pair?.en === 'string' && typeof pair?.ja === 'string')
			.map((pair) => ({
				en: normalizeScrollAnchorText(pair.en),
				ja: normalizeScrollAnchorText(pair.ja)
			}))
			.filter((pair) => pair.en.length >= 4 && pair.ja.length >= 4)
	}

	const getLocaleScrollAlignmentPairs = () => {
		const payload = window.__localeScrollAlignment
		if (
			!payload ||
			normalizePath(payload.contentPath ?? '/') !==
				normalizePath(stripLocale(window.location.pathname))
		) {
			return []
		}
		return alignmentPairsFromData(payload.alignment)
	}

	const anchorTextMatches = (blockText, anchorText) => {
		if (!blockText || !anchorText) return false
		if (blockText.length < 8 || anchorText.length < 8) return false
		return (
			blockText === anchorText || blockText.includes(anchorText) || anchorText.includes(blockText)
		)
	}

	const annotateArticleScrollAnchors = () => {
		const currentLocale = getPathLocale(window.location.pathname)
		if (currentLocale === 'mix') return

		const pairs = getLocaleScrollAlignmentPairs()
		if (pairs.length === 0) return

		getArticleBlocks().forEach((block) => {
			if (block.dataset.scrollAnchorEn && block.dataset.scrollAnchorJa) return

			const blockText = getComparableBlockText(block)
			const matchedPairs = pairs.filter((pair) => anchorTextMatches(blockText, pair[currentLocale]))
			if (matchedPairs.length === 0) return

			const englishText = normalizeScrollAnchorText(matchedPairs.map((pair) => pair.en).join(' '))
			const japaneseText = normalizeScrollAnchorText(matchedPairs.map((pair) => pair.ja).join(' '))
			if (englishText) block.dataset.scrollAnchorEn = englishText
			if (japaneseText) block.dataset.scrollAnchorJa = japaneseText
		})
	}

	const getBlockTextAnchors = (block, locale = getPathLocale(window.location.pathname)) => {
		const englishText = normalizeScrollAnchorText(block.dataset?.scrollAnchorEn)
		const japaneseText = normalizeScrollAnchorText(block.dataset?.scrollAnchorJa)
		const blockText = getComparableBlockText(block)

		return {
			en: englishText || (locale === 'en' ? blockText : ''),
			ja: japaneseText || (locale === 'ja' ? blockText : '')
		}
	}

	const findArticleBlockByTextAnchor = (anchor, blocks) => {
		const targetLocale = getPathLocale(window.location.pathname)
		const preferredLocales = targetLocale === 'mix' ? ['en', 'ja'] : [targetLocale]

		for (const locale of preferredLocales) {
			const savedText = anchor.textByLocale?.[locale]
			if (!savedText) continue

			const matchedBlock = blocks.find((block) => {
				const blockText = getBlockTextAnchors(block, targetLocale)[locale]
				return anchorTextMatches(blockText, savedText)
			})
			if (matchedBlock) return matchedBlock
		}

		return null
	}

	const getArticleScrollAnchor = () => {
		annotateArticleScrollAnchors()

		const blocks = getArticleBlocks()
		if (blocks.length === 0) return null

		const referenceY = window.innerHeight * ARTICLE_VIEWPORT_ANCHOR_RATIO
		const visibleBlock =
			blocks.find((block) => {
				const rect = block.getBoundingClientRect()
				return rect.bottom >= referenceY && rect.top <= window.innerHeight
			}) ??
			blocks.find((block) => block.getBoundingClientRect().bottom >= 0) ??
			blocks[0]

		const rect = visibleBlock.getBoundingClientRect()
		const blockIndex = blocks.indexOf(visibleBlock)
		const blockOffsetRatio =
			rect.height > 0 ? clamp((referenceY - rect.top) / rect.height, 0, 1) : 0

		return {
			blockIndex,
			blockOffsetRatio,
			textByLocale: getBlockTextAnchors(visibleBlock),
			viewportRatio: ARTICLE_VIEWPORT_ANCHOR_RATIO
		}
	}

	const scrollToArticleAnchor = (anchor) => {
		if (!anchor || typeof anchor.blockIndex !== 'number') return false

		annotateArticleScrollAnchors()

		const blocks = getArticleBlocks()
		if (blocks.length === 0) return false

		const block = findArticleBlockByTextAnchor(anchor, blocks)
		if (!block) return false

		const rect = block.getBoundingClientRect()
		const maxScroll = Math.max(0, getScrollableHeight() - window.innerHeight)
		const viewportY = window.innerHeight * (anchor.viewportRatio ?? ARTICLE_VIEWPORT_ANCHOR_RATIO)
		const blockY = window.scrollY + rect.top + rect.height * (anchor.blockOffsetRatio ?? 0)
		const targetY = clamp(blockY - viewportY, 0, maxScroll)

		window.scrollTo({ top: targetY, left: 0, behavior: 'instant' })
		return Math.abs(window.scrollY - targetY) < 4
	}

	const saveScrollPosition = (targetLocale) => {
		const maxScroll = Math.max(1, getScrollableHeight() - window.innerHeight)
		const isAtPageTop = window.scrollY <= 1
		const saved = {
			locale: targetLocale,
			path: stripLocale(window.location.pathname),
			y: window.scrollY,
			ratio: window.scrollY / maxScroll,
			anchor: isAtPageTop ? null : getArticleScrollAnchor(),
			time: Date.now()
		}

		try {
			window.sessionStorage.setItem(SCROLL_KEY, JSON.stringify(saved))
		} catch {
			// Ignore unavailable storage; navigation still works normally.
		}

		pendingScrollRestore = saved
		return saved
	}

	const readSavedScrollPosition = () => {
		if (pendingScrollRestore) return pendingScrollRestore

		try {
			const raw = window.sessionStorage.getItem(SCROLL_KEY)
			pendingScrollRestore = raw ? JSON.parse(raw) : null
			return pendingScrollRestore
		} catch {
			return null
		}
	}

	const clearScheduledScrollRestores = () => {
		scrollRestoreRun += 1
		for (const timer of scrollRestoreTimers) {
			window.clearTimeout(timer)
		}
		scrollRestoreTimers = []
	}

	const clearSavedScrollPosition = () => {
		pendingScrollRestore = null
		try {
			window.sessionStorage.removeItem(SCROLL_KEY)
		} catch {
			// Ignore unavailable storage; the pending in-memory value is already cleared.
		}
	}

	const restoreScrollPosition = () => {
		const saved = readSavedScrollPosition()

		if (!saved || Date.now() - saved.time > 10000) return
		if (saved.locale !== getPathLocale(window.location.pathname)) return
		if (saved.path !== stripLocale(window.location.pathname)) return

		clearScheduledScrollRestores()
		const restoreRun = scrollRestoreRun

		const scrollWithoutSmooth = () => {
			const maxScroll = Math.max(0, getScrollableHeight() - window.innerHeight)
			if (maxScroll <= 0 && saved.y > 0) return false

			const root = document.documentElement
			const previousBehavior = root.style.scrollBehavior

			root.style.scrollBehavior = 'auto'
			if (scrollToArticleAnchor(saved.anchor)) {
				root.style.scrollBehavior = previousBehavior
				return true
			}

			const targetY = Math.min(saved.y ?? maxScroll * (saved.ratio ?? 0), maxScroll)
			window.scrollTo({ top: targetY, left: 0, behavior: 'instant' })
			root.style.scrollBehavior = previousBehavior
			return Math.abs(window.scrollY - targetY) < 4
		}

		const clearWhenRestored = (isFinalAttempt = false) => {
			if (restoreRun !== scrollRestoreRun) return
			if (readSavedScrollPosition() !== saved) return
			const restored = scrollWithoutSmooth()
			if (restored && isFinalAttempt) {
				clearSavedScrollPosition()
				clearScheduledScrollRestores()
			}
		}

		const scheduleRestore = (delay, isFinalAttempt = false) => {
			const timer = window.setTimeout(() => clearWhenRestored(isFinalAttempt), delay)
			scrollRestoreTimers.push(timer)
		}

		clearWhenRestored()
		if (readSavedScrollPosition() !== saved) return
		window.requestAnimationFrame(() => clearWhenRestored())
		scheduleRestore(80)
		scheduleRestore(180)
		scheduleRestore(400)
		scheduleRestore(800)
		scheduleRestore(1200, true)
	}

	const cancelScrollRestoreForUserInput = () => {
		if (!readSavedScrollPosition()) return
		clearSavedScrollPosition()
		clearScheduledScrollRestores()
	}

	const cancelScrollRestoreForScrollKey = (event) => {
		if (
			[
				'ArrowDown',
				'ArrowLeft',
				'ArrowRight',
				'ArrowUp',
				'End',
				'Home',
				'PageDown',
				'PageUp',
				' '
			].includes(event.key)
		) {
			cancelScrollRestoreForUserInput()
		}
	}

	const syncLocale = () => {
		const currentLocale = getPathLocale(window.location.pathname)
		const contentPath = stripLocale(window.location.pathname)

		if (currentLocale !== DEFAULT_LOCALE) {
			setStoredLocale(currentLocale)
			return
		}

		const preferredLocale = getStoredLocale() ?? DEFAULT_LOCALE
		if (
			currentLocale === preferredLocale ||
			preferredLocale === DEFAULT_LOCALE ||
			!canRedirectToLocale(preferredLocale, contentPath)
		) {
			return
		}

		const target = buildLocaleTarget(preferredLocale, contentPath)
		if (target === window.location.href || target === window.location.pathname) return

		window.location.replace(target)
	}

	document.addEventListener(
		'click',
		(event) => {
			if (!(event.target instanceof Element)) return

			const switchLink = event.target.closest('a[data-locale-switch]')
			if (!(switchLink instanceof HTMLAnchorElement)) return
			if (event.defaultPrevented) return
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)
				return
			if (switchLink.target && switchLink.target !== '_self') return

			const targetLocale = switchLink.dataset.localeSwitch
			if (new URL(switchLink.href, window.location.href).href === window.location.href) {
				event.preventDefault()
				return
			}

			event.preventDefault()
			switchLocale(targetLocale, switchLink.href)
		},
		{ capture: true }
	)

	window.addEventListener(
		'touchstart',
		(event) => {
			if (!isMobileSwipeWidth() || event.touches.length !== 1) {
				swipeStart = null
				return
			}
			if (isSwipeIgnoredTarget(event.target)) {
				swipeStart = null
				return
			}

			const touch = event.touches[0]
			swipeStart = { x: touch.clientX, y: touch.clientY }
		},
		{ passive: true }
	)

	window.addEventListener(
		'touchend',
		(event) => {
			if (!swipeStart || event.changedTouches.length !== 1) return

			const touch = event.changedTouches[0]
			const deltaX = touch.clientX - swipeStart.x
			const deltaY = touch.clientY - swipeStart.y
			swipeStart = null

			if (Math.abs(deltaX) < SWIPE_MIN_DISTANCE) return
			if (Math.abs(deltaY) > SWIPE_MAX_VERTICAL_DISTANCE) return
			if (Math.abs(deltaY) > Math.abs(deltaX) * 0.75) return

			switchLocaleBySwipe(deltaX < 0 ? 1 : -1)
		},
		{ passive: true }
	)

	window.addEventListener('pagereveal', restoreScrollPosition)
	window.addEventListener('wheel', cancelScrollRestoreForUserInput, { passive: true })
	window.addEventListener('touchmove', cancelScrollRestoreForUserInput, { passive: true })
	window.addEventListener('keydown', cancelScrollRestoreForScrollKey)
	document.addEventListener('DOMContentLoaded', () => {
		annotateArticleScrollAnchors()
		restoreScrollPosition()
	})
	document.addEventListener('astro:page-load', () => {
		syncLocale()
		annotateArticleScrollAnchors()
		restoreScrollPosition()
	})
	annotateArticleScrollAnchors()
	syncLocale()
</script>
