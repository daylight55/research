{
	"name": "personal-research-atlas",
	"type": "module",
	"version": "1.1.0",
	"description": "AI、データ、組織ナレッジの調査レポートを自分向けに蓄積して読むための静的アトラス。",
	"author": "daylight55",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/daylight55/research"
	},
	"keywords": [
		"astro",
		"astrojs",
		"astro-template",
		"astro-blog",
		"astro-b"
	],
	"bugs": {
		"url": "https://github.com/daylight55/research/issues"
	},
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"sync": "astro sync",
		"preview": "astro preview",
		"postbuild": "pagefind --site dist",
		"test:workflows": "node .github/tests/daily-issue-research-workflow.test.mjs",
		"test:content": "node --test .github/tests/news-title-summaries.test.mjs",
		"test:i18n": "node --test .github/tests/i18n-content.test.mjs",
		"test:hero-images": "node --test .github/tests/select-unsplash-hero.test.mjs .github/tests/hero-images.test.mjs .github/tests/news-source-card-images.test.mjs",
		"format:check": "prettier --plugin-search-dir=. --check .",
		"format": "prettier --plugin-search-dir=. --write .",
		"lint": "eslint ."
	},
	"dependencies": {
		"@astrojs/rss": "4.0.18",
		"astro": "6.3.7",
		"beautiful-mermaid": "1.1.3",
		"mermaid": "^11.15.0"
	},
	"devDependencies": {
		"@astrojs/mdx": "5.0.6",
		"@astrojs/tailwind": "6.0.2",
		"@pagefind/default-ui": "^1.0.4",
		"@tailwindcss/typography": "0.5.10",
		"@typescript-eslint/parser": "^8.59.4",
		"clsx": "2.0.0",
		"eslint": "^8.56.0",
		"eslint-plugin-astro": "^0.31.0",
		"eslint-plugin-jsx-a11y": "^6.8.0",
		"mdast-util-to-string": "^4.0.0",
		"motion": "^10.16.4",
		"pagefind": "^1.0.3",
		"prettier": "^3.0.3",
		"prettier-config-standard": "^7.0.0",
		"prettier-plugin-astro": "^0.12.0",
		"reading-time": "^1.5.0",
		"slugify": "^1.6.6",
		"tailwind-merge": "2.0.0",
		"tailwindcss": "3.3.5",
		"typescript": "^5.2.2"
	},
	"lint-staged": {
		"*.{astro,js,jsx,ts,tsx,md,mdx,json}": [
			"prettier --write --plugin-search-dir=."
		]
	}
}
