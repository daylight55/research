---
import { formatArticleDate } from '@/utils/archive'
export interface Props {
	date: Date
	locale?: string
}
const pathLocale = /^\/(?:en|mix)(?:\/|$)/.test(Astro.url.pathname) ? 'en' : 'ja'
const { date, locale = pathLocale } = Astro.props
---

<time datetime={date.toISOString()}>{formatArticleDate(date, locale)}</time>
