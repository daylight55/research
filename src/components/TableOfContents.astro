---
import TableOfContentsHeading from '@/components/TabletOfContentsHeading'
import type { MarkdownHeading } from 'astro'
const { headings, locale = 'ja' } = Astro.props as { headings: MarkdownHeading[]; locale?: string }
type TocHeading = MarkdownHeading & { subheadings: TocHeading[] }
const toc: TocHeading[] = []
for (const heading of headings.filter((heading) => heading.depth > 1 && heading.depth <= 3)) {
	const item: TocHeading = { ...heading, subheadings: [] }
	if (item.depth === 3 && toc.length) toc[toc.length - 1].subheadings.push(item)
	else toc.push(item)
}
---

<nav class='table-of-contents' aria-label={locale === 'ja' ? '目次' : 'On this page'}>
	<p class='toc-label'>{locale === 'ja' ? '目次' : 'On this page'}</p>
	<ul>{toc.map((heading) => <TableOfContentsHeading heading={heading} />)}</ul>
</nav>
