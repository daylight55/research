---
import BaseLayout from '@/layouts/BaseLayout'
import ArticleArchive from '@/components/ArticleArchive'
import { getNewsPosts } from '@/utils'

const locale = 'en'
const posts = await getNewsPosts(undefined, locale)
---

<BaseLayout title='News' locale={locale}>
	<header class='archive-heading'>
		<h1>News</h1>
		<p>Follow politics, economics and technology, day by day.</p>
	</header>
	<ArticleArchive posts={posts} locale={locale} section='news' />
</BaseLayout>
