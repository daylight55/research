---
type Tone = 'politics' | 'economy' | 'technology'

type Props = {
	tone: Tone
}

const { tone } = Astro.props

const toneClasses: Record<Tone, string> = {
	politics: 'border-rose-200/80 bg-rose-50/70 dark:border-rose-800/50 dark:bg-rose-950/25',
	economy:
		'border-emerald-200/80 bg-emerald-50/70 dark:border-emerald-800/50 dark:bg-emerald-950/25',
	technology: 'border-sky-200/80 bg-sky-50/70 dark:border-sky-800/50 dark:bg-sky-950/25'
}
---

<section
	class:list={[
		'news-digest-section my-8 rounded-md border px-4 py-1 shadow-sm sm:px-6',
		toneClasses[tone]
	]}
	data-news-section={tone}
>
	<slot />
</section>
