---
import ListCategories from '@/components/ListCategories'
import ListPosts from '@/components/ListPosts'
import BaseLayout from '@/layouts/BaseLayout'
import { getPosts, withBase } from '@/utils'
import { siteConfig } from '@/site-config'

const posts = await getPosts()
---

<BaseLayout title='Home'>
	<section class='grid gap-4 border-b border-black/10 pb-8 dark:border-white/10'>
		<p class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'>
			Personal Atlas
		</p>
		<div class='grid gap-3'>
			<h1 class='max-w-4xl text-4xl font-semibold leading-tight md:text-5xl'>
				{siteConfig.title}
			</h1>
			<p class='max-w-3xl text-lg leading-8 text-gray-700 dark:text-gray-300'>
				{siteConfig.description}
			</p>
		</div>
	</section>

	<div class='grid gap-8'>
		<section>
			<div class='mb-4 grid gap-2'>
				<p
					class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
				>
					Reports
				</p>
				<h2 class='text-2xl font-semibold'>最新レポート</h2>
			</div>
			<ListPosts posts={posts} />
		</section>

		<div class='grid gap-4'>
			<div>
				<p
					class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
				>
					Index
				</p>
				<h2 class='text-2xl font-semibold'>調査カテゴリ</h2>
			</div>
			<div class='overflow-x-auto pb-1'>
				<ListCategories />
			</div>
		</div>

		<section class='grid gap-4'>
			<div>
				<p
					class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
				>
					Reference
				</p>
				<h2 class='text-2xl font-semibold'>基本情報・統計ソース</h2>
			</div>
			<a
				href={withBase('/reference/statistical-sources')}
				class='group grid gap-4 rounded-md border border-black/10 bg-white/70 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-black/30 hover:shadow-md dark:border-white/10 dark:bg-white/10 dark:hover:border-white/30 md:grid-cols-[1fr_auto] md:items-center'
			>
				<div class='grid gap-2'>
					<h3 class='text-xl font-semibold'>国別調査に使う統計・データソース一覧</h3>
					<p class='max-w-3xl leading-7 text-gray-700 dark:text-gray-300'>
						World
						Bank、IMF、UN、SIPRI、V-Dem、UNHCRなど、国際政治・経済・人口・安全保障・生活水準を比較するための主要データベースを整理した常設リファレンス。
					</p>
				</div>
				<span
					class='text-sm font-semibold text-gray-900 transition group-hover:translate-x-1 dark:text-gray-100'
					>開く →</span
				>
			</a>
		</section>
	</div>
</BaseLayout>
