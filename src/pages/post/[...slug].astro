---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import BlogPost from '@/layouts/BlogPost'
import Code from '@/components/mdx/Code'
import ListRelatedPosts from '@/components/ListRelatedPosts'
import FormattedDate from '@/components/FormattedDate'
import Share from '@/components/Share'
import TableOfContents from '@/components/TableOfContents'
import MermaidRenderer from '@/components/MermaidRenderer'
import { DEFAULT_LOCALE, getPostSlug, getPostUrl, getPosts, localizedPath } from '@/utils'
import SButton from '@/components/mdx/SButton'
import SourceNote from '@/components/mdx/SourceNote'
import Disqus from '@/components/Disqus'
import { disqusConfig } from '@/data/disqus.config'

const locale = DEFAULT_LOCALE
const posts = (await getCollection('blog')).filter((post) => post.id.split('/')[0] !== 'en')
export async function getStaticPaths() {
	const posts = await getPosts()

	return posts.map((post) => ({
		params: { slug: getPostSlug(post) },
		props: post
	}))
}
type Props = CollectionEntry<'blog'>

const post = Astro.props
const postSlug = getPostSlug(post)
const MAX_POSTS = 3
const getRelatedPosts = (post: Props) => {
	const lowercaseTags = post.data.tags.map((tag) => tag.toLowerCase())
	const relatedPosts = posts.filter(
		(p) => p.id !== post.id && p.data.tags.some((t) => lowercaseTags.includes(t.toLowerCase()))
	)
	return relatedPosts.slice(0, MAX_POSTS)
}

const relatedPosts = getRelatedPosts(post)
const researchEntries = await getCollection('articleResearch')
const hasResearchLog = researchEntries.some((entry) => getPostSlug(entry) === postSlug)

const { Content, headings, remarkPluginFrontmatter } = await render(post)
const glossaryTerms = (remarkPluginFrontmatter.glossaryTerms ?? []).slice(0, 18)

const disqusEnabled = disqusConfig.enabled
---

<BlogPost
	id={post.id}
	data={post.data}
	headings={headings}
	readTime={remarkPluginFrontmatter.minutesRead}
	locale={locale}
>
	<div
		class='grid grid-cols-1 gap-8 mt-8 lg:grid-cols-[9rem_minmax(0,1fr)_9rem] lg:justify-center lg:gap-4 xl:grid-cols-[10rem_minmax(0,56rem)_10rem] 2xl:grid-cols-[12rem_minmax(0,62rem)_12rem]'
	>
		<!-- article context -->
		<aside class='hidden lg:flex flex-col gap-6 pr-3 text-sm text-gray-600 dark:text-gray-400'>
			<div class='sticky top-24 flex flex-col gap-6 self-start'>
				<section class='flex flex-col gap-2'>
					<p
						class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'
					>
						Reports
					</p>
					<div class='flex flex-col gap-1.5 leading-snug'>
						<span>{post.data.category}</span>
						<FormattedDate date={post.data.pubDate} />
						<span>{remarkPluginFrontmatter.minutesRead}</span>
					</div>
				</section>

				{
					hasResearchLog && (
						<section class='flex flex-col gap-2'>
							<p class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
								Research
							</p>
							<a
								href={localizedPath(locale, `/post/${postSlug}/research/`)}
								class='leading-snug text-gray-600 underline decoration-black/20 underline-offset-4 transition-colors hover:text-indigo-700 dark:text-gray-400 dark:decoration-white/20 dark:hover:text-indigo-300'
							>
								調査プロセスを見る
							</a>
						</section>
					)
				}

				<section class='flex flex-col gap-2'>
					<p
						class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'
					>
						Tags
					</p>
					<ul class='flex flex-col gap-1.5'>
						{
							post.data.tags.map((tag) => (
								<li>
									<a
										href={localizedPath(locale, `/tags/${encodeURIComponent(tag.toLowerCase())}`)}
										class='leading-snug text-gray-600 underline decoration-black/20 underline-offset-4 transition-colors hover:text-indigo-700 dark:text-gray-400 dark:decoration-white/20 dark:hover:text-indigo-300'
									>
										#{tag}
									</a>
								</li>
							))
						}
					</ul>
				</section>

				{
					glossaryTerms.length > 0 && (
						<section class='flex flex-col gap-2'>
							<p class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
								用語一覧
							</p>
							<ul class='flex flex-col gap-1.5'>
								{glossaryTerms.map((term) => (
									<li>
										<a
											href={localizedPath(locale, `/glossary/${term.slug}/`)}
											class='leading-snug text-gray-600 underline decoration-black/20 underline-offset-4 transition-colors hover:text-indigo-700 dark:text-gray-400 dark:decoration-white/20 dark:hover:text-indigo-300'
										>
											{term.label}
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}

				{
					relatedPosts.length > 0 && (
						<section class='flex flex-col gap-2'>
							<p class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
								Related
							</p>
							<ul class='flex flex-col gap-2.5'>
								{relatedPosts.map((relatedPost) => (
									<li>
										<a
											href={getPostUrl(relatedPost)}
											class='block leading-snug text-gray-600 transition-colors hover:text-indigo-700 dark:text-gray-400 dark:hover:text-indigo-300'
										>
											{relatedPost.data.title}
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}

				<Share title={post.data.title} />
			</div>
		</aside>

		<!-- post -->
		<article class='max-w-none w-full'>
			<div
				class='prose prose-base md:prose-lg dark:prose-invert mb-12 min-w-full max-w-none prose-p:leading-8 prose-li:leading-8'
			>
				<Content components={{ pre: Code, SButton, SourceNote }} />

				{
					hasResearchLog && (
						<section class='not-prose mt-12 rounded-md border border-black/10 bg-white/70 p-5 dark:border-white/10 dark:bg-white/10'>
							<p class='text-sm font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
								Research Trail
							</p>
							<h2 class='mt-2 text-xl font-semibold text-gray-900 dark:text-gray-100'>
								調査プロセス
							</h2>
							<p class='mt-2 leading-7 text-gray-700 dark:text-gray-300'>
								この記事で参照した問い、根拠、判断の流れは公開可能な調査ログとして確認できます。
							</p>
							<a
								href={localizedPath(locale, `/post/${postSlug}/research/`)}
								class='mt-4 inline-flex w-fit items-center rounded-full border border-black/10 px-4 py-2 text-sm font-semibold text-gray-900 transition hover:border-black/30 hover:bg-white dark:border-white/10 dark:text-gray-100 dark:hover:border-white/30 dark:hover:bg-white/10'
							>
								調査プロセスを見る
							</a>
						</section>
					)
				}
			</div>

			<!-- related posts -->
			<footer class='lg:hidden'>
				<h2 class='font-bold text-lg dark:text-white mb-6'>Related Posts</h2>
				<ListRelatedPosts posts={relatedPosts} />
			</footer>
		</article>

		<!-- aside  -->
		<aside class='hidden lg:flex flex-col gap-6 pl-2 text-sm text-gray-600 dark:text-gray-400'>
			<div class='sticky top-24 self-start hidden lg:block transition-all duration-200'>
				{headings && headings.length > 0 && <TableOfContents {headings} />}
			</div>
		</aside>
	</div>

	{disqusEnabled && <Disqus />}
</BlogPost>

<MermaidRenderer />
