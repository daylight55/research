---
import BaseLayout from '@/layouts/BaseLayout'
import ListPosts from '@/components/ListPosts'
import TitlePage from '@/components/TitlePage'
import { getReportPosts, withBase } from '@/utils'

const reportPosts = await getReportPosts()
---

<BaseLayout title='Reports'>
	<TitlePage title='Reports' />
	<div class='mb-6 grid gap-2'>
		<p class='max-w-3xl leading-7 text-gray-700 dark:text-gray-300'>
			調査レポートの一覧です。AI、データ、組織ナレッジ、地政学、金融、技術基盤などの長文レポートをまとめています。
		</p>
		<a
			href={withBase('/reports/rss.xml')}
			class='w-fit text-sm font-semibold text-gray-900 underline-offset-4 hover:underline dark:text-gray-100'
		>
			Report RSS
		</a>
	</div>
	<ListPosts posts={reportPosts} />
</BaseLayout>
