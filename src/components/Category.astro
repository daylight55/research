---
import {
	cn,
	DEFAULT_LOCALE,
	localizedPath,
	sluglify,
	stripLocaleFromPath,
	type Locale
} from '@/utils'

const {
	name = 'View All',
	activeCategory,
	locale = DEFAULT_LOCALE
} = Astro.props as {
	name?: string
	activeCategory?: string
	locale?: Locale
}
const currentPath = stripLocaleFromPath(Astro.url.pathname)
const unsluglifyNameCategory = sluglify(name.toLowerCase())

const isActive =
	activeCategory?.toLocaleLowerCase() === unsluglifyNameCategory ||
	(currentPath === '/reports/' && name === 'View All')
---

<a
	href={localizedPath(
		locale,
		name === 'View All' ? '/reports/' : sluglify(`/category/${unsluglifyNameCategory}/1`)
	)}
	class={cn(
		`inline-flex min-h-9 items-center rounded-md border border-black/10 bg-white/70 px-2.5 py-1.5 text-sm font-semibold text-gray-700 shadow-sm transition duration-150 ease-linear first-letter:uppercase hover:-translate-y-0.5 hover:border-black/25 hover:bg-white hover:text-gray-950 hover:shadow-md dark:border-white/10 dark:bg-white/10 dark:text-gray-200 dark:hover:border-white/30 dark:hover:bg-white/15 dark:hover:text-white`,
		`shrink-0 whitespace-nowrap`,
		isActive &&
			`border-gray-950 bg-gray-950 text-white shadow-md hover:bg-gray-950 hover:text-white dark:border-white dark:bg-white dark:text-gray-950 dark:hover:bg-white dark:hover:text-gray-950`
	)}
>
	{name}
</a>
