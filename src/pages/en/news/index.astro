---
import BaseLayout from '@/layouts/BaseLayout'
import ListPosts from '@/components/ListPosts'
import Pagination from '@/components/Pagination'
import TitlePage from '@/components/TitlePage'
import { createArticleListPage, getNewsPosts } from '@/utils'

const locale = 'en'
const newsPosts = await getNewsPosts(undefined, locale)
const page = createArticleListPage(newsPosts, 'news', 1, locale)
const posts = page.data
---

<BaseLayout title='News' locale={locale}>
	<TitlePage title='News' />
	<div class='mb-6 grid gap-2'>
		<p class='max-w-3xl leading-7 text-gray-700 dark:text-gray-300'>
			Translated news articles tracking technology, policy, research, security, and geopolitical
			trends.
		</p>
	</div>
	{
		posts.length > 0 ? (
			<>
				<ListPosts posts={posts} locale={locale} variant='compact' />
				<Pagination page={page} />
			</>
		) : (
			<p class='rounded-md border border-black/10 bg-white/70 p-5 leading-7 text-gray-700 dark:border-white/10 dark:bg-white/10 dark:text-gray-300'>
				English translations have not been generated yet.
			</p>
		)
	}
</BaseLayout>
