---
import { Image } from 'astro:assets'
import { DEFAULT_LOCALE, localizedPath } from '@/utils'
import { formatArticleDate } from '@/utils/archive'
import { getCategoryLabel } from '@/data/categoryLabels'

const {
	data: { title, description, rssSummary, pubDate, heroImage, category, contentType },
	slug,
	locale = DEFAULT_LOCALE,
	variant = 'card',
	headingLevel = 2
} = Astro.props
const Heading = headingLevel === 3 ? 'h3' : 'h2'
const postUrl = localizedPath(locale, `/${contentType === 'news' ? 'news' : 'reports'}/${slug}/`)
---

<article class:list={['post-card', variant === 'compact' && 'post-card-compact']}>
	<Image
		src={heroImage}
		width={320}
		height={220}
		format='webp'
		loading='lazy'
		alt=''
		class='post-card-image'
	/>
	<div class='post-card-copy'>
		<div class='post-card-meta'>
			<time datetime={pubDate.toISOString()}>{formatArticleDate(pubDate, locale)}</time>
			<span>{getCategoryLabel(category, locale)}</span>
		</div>
		<Heading><a href={postUrl}>{title}</a></Heading>
		<p>{rssSummary ?? description}</p>
	</div>
</article>
