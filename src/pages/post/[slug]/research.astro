---
import { getPostSlug, localizedPath, getReportPosts } from '@/utils'

type Props = {
	target: string
}

export async function getStaticPaths() {
	const posts = await getReportPosts()

	return posts.map((post) => {
		const slug = getPostSlug(post)
		return {
			params: { slug },
			props: { target: localizedPath('ja', `/reports/${slug}/research/`) }
		}
	})
}

const { target } = Astro.props as Props
---

<!doctype html>
<html lang='ja'>
	<head>
		<meta charset='utf-8' />
		<meta http-equiv='refresh' content={`0; url=${target}`} />
		<meta name='robots' content='noindex' />
		<link rel='canonical' href={target} />
		<title>Redirecting...</title>
	</head>
	<body>
		<a href={target}>Redirecting...</a>
	</body>
</html>
