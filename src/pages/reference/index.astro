---
import BaseLayout from '@/layouts/BaseLayout'
import { getReferenceItems } from '@/data/references'
import { localizedPath } from '@/utils'
const locale = 'ja'
const referenceItems = getReferenceItems(locale)
---

<BaseLayout title='Reference' locale={locale}>
	<header class='archive-heading'>
		<h1>リファレンス</h1><p>統計・データソースと一次情報の入口をまとめています。</p>
	</header>
	<div class='reference-links'>
		{
			referenceItems.map((item) => (
				<a href={localizedPath(locale, item.href)}>
					<>
						<h2>{item.title}</h2>
						<p>{item.description}</p>
					</>
				</a>
			))
		}
	</div>
</BaseLayout>
