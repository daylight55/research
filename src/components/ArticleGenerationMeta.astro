---
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '@/utils'

type Generation = CollectionEntry<'blog'>['data']['generation']

type Props = {
	generation?: Generation
	locale?: Locale
}

const { generation, locale = 'ja' } = Astro.props
const labels =
	locale === 'en'
		? {
				title: 'Article generation',
				model: 'Model used',
				promptSource: 'Prompt source',
				promptSummary: 'Prompt summary'
			}
		: {
				title: '記事生成情報',
				model: '使用モデル',
				promptSource: 'プロンプト',
				promptSummary: 'プロンプト要約'
			}
const promptSummary = generation?.promptSummary ?? []
const promptSource = generation?.promptSource
const sourceIsUrl = promptSource?.startsWith('http://') || promptSource?.startsWith('https://')
---

{
	generation?.model && (
		<section class='my-5 rounded-md border border-gray-200 bg-gray-50/80 px-4 py-3 text-sm text-gray-700 dark:border-white/10 dark:bg-white/5 dark:text-gray-300'>
			<p class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
				{labels.title}
			</p>
			<dl class='mt-2 grid gap-2 sm:grid-cols-[max-content_minmax(0,1fr)]'>
				<dt class='font-semibold text-gray-800 dark:text-gray-100'>{labels.model}</dt>
				<dd class='min-w-0 break-words font-mono text-xs sm:text-sm'>{generation.model}</dd>
				{promptSource && (
					<>
						<dt class='font-semibold text-gray-800 dark:text-gray-100'>{labels.promptSource}</dt>
						<dd class='min-w-0 break-words'>
							{sourceIsUrl ? (
								<a
									href={promptSource}
									target='_blank'
									rel='noreferrer'
									class='underline decoration-black/20 underline-offset-4 hover:text-indigo-700 dark:decoration-white/20 dark:hover:text-indigo-300'
								>
									{promptSource}
								</a>
							) : (
								<code class='rounded bg-black/5 px-1 py-0.5 text-xs dark:bg-white/10'>
									{promptSource}
								</code>
							)}
						</dd>
					</>
				)}
			</dl>
			{promptSummary.length > 0 && (
				<div class='mt-3'>
					<p class='font-semibold text-gray-800 dark:text-gray-100'>{labels.promptSummary}</p>
					<ul class='mt-1 list-disc space-y-1 pl-5'>
						{promptSummary.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</div>
			)}
		</section>
	)
}
