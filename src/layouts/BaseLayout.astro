---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import ProviderTheme from '@/components/ProviderTheme'
import ProviderAnimations from '@/components/ProviderAnimations'
import TwSizeIndicator from '@/components/TwSizeIndicator'
import { DEFAULT_LOCALE } from '@/utils'
const { title, description, image, articleDate, locale = DEFAULT_LOCALE } = Astro.props
---

<html lang={locale} class='scroll-smooth'>
	<head>
		<BaseHead title={title} description={description} ogImage={image} articleDate={articleDate} />
		<ProviderTheme />
		<ProviderAnimations />
	</head>

	<body class='bg-[#f8f7f2] text-[#181713] dark:bg-[#11110f] dark:text-[#f4efe4]'>
		<main
			class='px-5 sm:mx-auto sm:max-w-2xl sm:px-8 lg:px-0 antialiased md:max-w-[82rem] 2xl:max-w-[90rem] grid gap-12 mt-4 overflow-hidden md:overflow-visible'
		>
			<Header locale={locale} />
			<slot />
			<Footer />
		</main>
		<TwSizeIndicator />
		<style>
			body {
				margin-left: calc(100vw - 100%); /* prevent layout shift */
			}
		</style>
	</body>
</html>
