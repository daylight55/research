---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

type Props = {
	image: ImageMetadata | string
	alt: string
	caption: string
	credit: string
	sourceUrl: string
	rights: string
	rightsUrl?: string
	width?: number
	height?: number
	locale?: 'ja' | 'en'
	detail?: boolean
	position?: string
	imageLink?: string
}

const {
	image,
	alt,
	caption,
	credit,
	sourceUrl,
	rights,
	rightsUrl,
	locale = 'ja',
	detail = false,
	position = '50% 50%',
	imageLink
} = Astro.props
const width = typeof image === 'string' ? Astro.props.width : image.width
const height = typeof image === 'string' ? Astro.props.height : image.height
if (!alt?.trim() || !caption?.trim() || !credit?.trim() || !rights?.trim()) {
	throw new Error('ArticleFigure requires alt text, a caption, credit, and rights information.')
}
if (!width || !height) throw new Error('ArticleFigure requires image dimensions.')

const isSvg = typeof image === 'string' ? /\.svg(?:\?|$)/i.test(image) : image.format === 'svg'
const widths = [
	...new Set([480, 960, 1440].filter((value) => value < width).concat(Math.min(width, 1440)))
]
const original = typeof image === 'string' ? image : image.src
const href = imageLink ?? original
const linkLabel = imageLink
	? locale === 'en'
		? 'View the work at its source'
		: '作品の掲載元を見る'
	: locale === 'en'
		? 'Open full-size image'
		: '画像を拡大して見る'
const hint = imageLink
	? locale === 'en'
		? 'Select the image to visit its source.'
		: '画像をクリックして掲載元へ'
	: locale === 'en'
		? 'Select the image to enlarge it.'
		: '画像をクリックして拡大'
---

<figure class='article-figure not-prose' data-article-figure>
	<a
		href={href}
		target='_blank'
		rel='noreferrer'
		aria-label={`${alt} — ${linkLabel}`}
		class:list={['article-figure__view', { 'article-figure__view--detail': detail }]}
		style={`--figure-position: ${position}`}
	>
		<Image
			src={image}
			alt={alt}
			width={width}
			height={height}
			format={isSvg ? undefined : 'webp'}
			widths={isSvg ? undefined : widths}
			sizes={isSvg ? undefined : '(min-width: 1280px) 900px, (min-width: 1024px) 70vw, 100vw'}
			quality={85}
			loading='lazy'
			decoding='async'
			class='article-figure__image'
		/>
	</a>
	<figcaption class='article-figure__caption'>
		<span data-figure-caption>{caption}</span>
		<span class='article-figure__credit'>
			<a href={sourceUrl} data-figure-source target='_blank' rel='noreferrer'>{credit}</a>
			<span aria-hidden='true'> ·</span>
			<span data-figure-rights>
				{
					rightsUrl ? (
						<a href={rightsUrl} target='_blank' rel='noreferrer'>
							{rights}
						</a>
					) : (
						rights
					)
				}
			</span>
		</span>
		<span class='article-figure__hint'>{hint}</span>
	</figcaption>
</figure>

<style>
	.article-figure {
		margin: 2rem 0;
	}
	.article-figure__view {
		display: block;
		border-radius: 0.25rem;
	}
	.article-figure__view:focus-visible {
		outline: 3px solid #6366f1;
		outline-offset: 4px;
	}
	.article-figure__image {
		display: block;
		width: 100%;
		height: auto;
		max-height: 44rem;
		object-fit: contain;
	}
	.article-figure__view--detail {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	.article-figure__view--detail .article-figure__image {
		height: 100%;
		max-height: none;
		object-fit: cover;
		object-position: var(--figure-position);
	}
	.article-figure__caption {
		display: grid;
		gap: 0.35rem;
		margin-top: 0.75rem;
		font-size: 0.875rem;
		line-height: 1.7;
		overflow-wrap: anywhere;
	}
	.article-figure__credit,
	.article-figure__hint {
		color: #64748b;
		font-size: 0.75rem;
	}
	.article-figure__credit a {
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	:global(html.dark) .article-figure__credit,
	:global(html.dark) .article-figure__hint {
		color: #94a3b8;
	}
</style>
