---
import BaseLayout from '@/layouts/BaseLayout'
import ArticleArchive from '@/components/ArticleArchive'
import { getReportPosts, withBase } from '@/utils'

const locale = 'ja'
const posts = await getReportPosts(undefined, locale)
---

<BaseLayout title='Reports' locale={locale}>
	<header class='archive-heading'>
		<h1>Reports</h1>
		<p>国・テーマ・掲載時期から、調査レポートを探す。</p>
		<a href={withBase('/reports/rss.xml')}>Reports RSS <span aria-hidden='true'>↗</span></a>
	</header>
	<ArticleArchive posts={posts} locale={locale} section='reports' />
</BaseLayout>
