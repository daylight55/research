---
import type { HTMLAttributes } from 'astro/types'
import { cn, DEFAULT_LOCALE, localizedPath, stripLocaleFromPath, type Locale } from '@/utils'
type Props = HTMLAttributes<'a'>

const {
	href,
	class: className,
	locale = DEFAULT_LOCALE,
	...props
} = Astro.props as Props & {
	locale?: Locale
}

const { pathname } = Astro.url
const currentPath = stripLocaleFromPath(pathname)
const isActive =
	typeof href === 'string' &&
	(href === currentPath || (href !== '/' && currentPath.startsWith(href.replace(/\/$/, '') + '/')))
const isInternalPath = typeof href === 'string' && href.startsWith('/')
const resolvedHref = isInternalPath ? localizedPath(locale, href) : href
---

<a
	href={resolvedHref}
	aria-current={isActive ? 'page' : undefined}
	class={cn(isActive ? 'text-opacity-100' : 'text-opacity-60', className)}
	rel='noopener noreferrer '
	{...props}
>
	<slot />
</a>
