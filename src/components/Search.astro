---
// Inspired by -> https://github.com/chrismwilliams/astro-theme-cactus/blob/main/src/components/Search.astro

import '@pagefind/default-ui/css/ui.css'
import SearchIcon from '@/components/icons/SearchIcon'
const { locale = 'ja' } = Astro.props
const ja = locale === 'ja'
---

<site-search id='search' class='inline-flex'>
	<button
		data-open-modal
		aria-label={ja ? 'サイト内を検索' : 'Search the site'}
		type='button'
		disabled
		class='flex h-9 w-9 items-center justify-center rounded-md transition-colors hover:bg-black/5 dark:hover:bg-white/10'
	>
		<SearchIcon />
		<!-- <span class='md:hidden text-2xl'> Search</span> -->
	</button>
	<dialog
		aria-label={ja ? 'サイト内検索' : 'Site search'}
		class='h-full max-h-full w-full max-w-full border border-zinc-400 bg-white dark:bg-[#0a0910ec] shadow backdrop:backdrop-blur sm:mx-auto sm:mb-auto sm:mt-16 sm:h-max sm:max-h-[calc(100%-8rem)] sm:min-h-[15rem] sm:w-5/6 sm:max-w-[48rem] sm:rounded-md'
	>
		<div class='dialog-frame flex flex-col gap-4 p-6 pt-12 sm:pt-6'>
			<form method='dialog' class='ms-auto'>
				<button
					data-close-modal
					class='cursor-pointer rounded-full bg-black text-white px-4 py-2 dark:bg-white dark:text-black'
					>{ja ? '閉じる' : 'Close'}</button
				>
			</form>
			{
				import.meta.env.DEV ? (
					<div class='mx-auto text-center dark:text-white'>
						<p>
							Search is only available in production builds. <br />
							Try building and previewing the site to test it out locally.
						</p>
					</div>
				) : (
					<div class='search-container dark:text-white'>
						<div id='pagefind__search' />
					</div>
				)
			}
		</div>
	</dialog>
</site-search>

<script>
	class SiteSearch extends HTMLElement {
		private lifecycle = new AbortController()

		disconnectedCallback() {
			this.lifecycle.abort()
			this.querySelector('dialog')?.close()
			document.body.classList.remove('overflow-hidden')
		}

		constructor() {
			super()
			const openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]')!
			const closeBtn = this.querySelector<HTMLButtonElement>('button[data-close-modal]')!
			const dialog = this.querySelector('dialog')!
			const dialogFrame = this.querySelector('.dialog-frame')!
			let pagefindReady: Promise<void> | undefined

			const loadPagefind = () => {
				if (import.meta.env.DEV) return Promise.resolve()
				pagefindReady ??= (async () => {
					// @ts-ignore
					const { PagefindUI } = await import('@pagefind/default-ui')
					new PagefindUI({
						element: '#pagefind__search',
						baseUrl: import.meta.env.BASE_URL,
						bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
						showImages: false
					})
				})()
				return pagefindReady
			}
			const onDialogClick = (event: MouseEvent) => {
				if (event.target === dialog && !dialogFrame.contains(event.target as Node)) {
					closeModal()
				}
			}
			const openModal = (event?: MouseEvent) => {
				if (!this.isConnected || dialog.open) return
				dialog.showModal()

				document.body.classList.add('overflow-hidden')
				loadPagefind()
					.then(() => {
						if (dialog.open && this.isConnected) this.querySelector('input')?.focus()
					})
					.catch(() => {
						const container = this.querySelector('#pagefind__search')
						if (container)
							container.textContent =
								document.documentElement.lang === 'ja'
									? '検索を読み込めませんでした。ページを再読み込みしてください。'
									: 'Search could not load. Please reload the page.'
					})
				event?.stopPropagation()
				dialog.addEventListener('click', onDialogClick)
			}

			const closeModal = () => {
				dialog.close()
				document.body.classList.remove('overflow-hidden')
				dialog.removeEventListener('click', onDialogClick)
			}

			openBtn.addEventListener('click', openModal)
			openBtn.disabled = false
			closeBtn.addEventListener('click', closeModal)
			dialog.addEventListener('close', () => {
				document.body.classList.remove('overflow-hidden')
				dialog.removeEventListener('click', onDialogClick)
			})
			document.addEventListener('astro:after-swap', closeModal, { signal: this.lifecycle.signal })

			// Listen for `/` keyboard shortcut
			window.addEventListener(
				'keydown',
				(e) => {
					if (
						e.key === '/' &&
						!dialog.open &&
						!e.ctrlKey &&
						!e.metaKey &&
						!e.altKey &&
						!(
							e.target instanceof HTMLElement &&
							(e.target.matches('input, textarea, select') || e.target.isContentEditable)
						)
					) {
						openModal()
						e.preventDefault()
					}
				},
				{ signal: this.lifecycle.signal }
			)
		}
	}

	if (!customElements.get('site-search')) customElements.define('site-search', SiteSearch)
</script>

<style is:global>
	.dark {
		--pagefind-ui-primary: #eeeeee;
		--pagefind-ui-text: #eeeeee;
		--pagefind-ui-background: #152028;
		--pagefind-ui-border: #152028;
		--pagefind-ui-tag: #152028;
	}
</style>
