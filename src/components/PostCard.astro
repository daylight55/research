---
import { Image } from 'astro:assets'
import FormattedDate from '@/components/FormattedDate'
import ArrowUp from '@/components/icons/ArrowUp'
import { DEFAULT_LOCALE, cn, getCategorySurfaceClass, localizedPath } from '@/utils'

const {
	id,
	data: { title, description, pubDate, heroImage, category, contentType },
	readTime,
	slug,
	locale = DEFAULT_LOCALE,
	isPriority = false,
	variant = 'card'
} = Astro.props
const postUrl = localizedPath(locale, `/${contentType === 'news' ? 'news' : 'reports'}/${slug}/`)
const isCompact = variant === 'compact'
---

<article
	class={cn(
		'grid min-h-full rounded-md p-2 transition-colors group',
		isCompact
			? 'gap-3 overflow-hidden lg:grid-cols-[10rem_minmax(0,1fr)]'
			: 'grid-rows-[auto_1fr]',
		getCategorySurfaceClass(category)
	)}
>
	<a
		class={cn(
			'relative block aspect-[16/9] min-w-0 overflow-hidden',
			isCompact && 'lg:aspect-auto lg:h-full lg:min-h-32 lg:w-full'
		)}
		href={postUrl}
	>
		<Image
			src={heroImage}
			width={800}
			height={450}
			format='webp'
			loading={isPriority ? 'eager' : 'lazy'}
			decoding={isPriority ? 'sync' : 'async'}
			fetchpriority={isPriority ? 'high' : undefined}
			class='h-full w-full object-cover hover:scale-[101%] transition-all duration-200 rounded-[2px]'
			alt={title}
		/>

		<div class={cn('z-30 absolute bottom-0 h-16 w-full', !isCompact && 'sm:h-20')}>
			<div class='-z-10 absolute bottom-0 glass w-full min-h-full'></div>
			<div
				class={cn(
					'flex items-center justify-between gap-x-2 px-3 py-3 text-white',
					!isCompact && 'sm:px-6 sm:py-4'
				)}
			>
				<div class='flex flex-col gap-1 items-center justify-center'>
					<FormattedDate date={pubDate} />
					<span class='text-xs sm:text-sm'> {readTime}</span>
				</div>

				<span
					class='rounded-full border border-white/40 bg-white/20 px-2 py-0.5 text-xs sm:text-sm'
				>
					{category}
				</span>
			</div>
		</div>
	</a>

	<div
		class={cn(
			'flex flex-col justify-between gap-4 pl-1',
			isCompact ? 'py-2 lg:min-w-0' : 'py-4 sm:py-6 md:gap-0'
		)}
	>
		<div class={cn('flex flex-col', isCompact ? 'gap-2' : 'gap-3')}>
			<div class='flex flex-col gap-2'>
				<a
					class={cn(
						'font-semibold',
						isCompact
							? 'line-clamp-2 text-base leading-6 sm:text-lg'
							: 'text-lg leading-7 sm:text-2xl sm:-tracking-wider'
					)}
					href={postUrl}
				>
					{title}
				</a>
			</div>

			<p
				class={cn(
					'overflow-hidden text-sm font-[400] leading-6 text-gray-700 dark:text-white',
					isCompact ? 'mb-2 line-clamp-2' : 'mb-3 line-clamp-3 sm:mb-5 sm:text-base md:pr-[15%]'
				)}
			>
				{description}
			</p>
		</div>

		<footer class='flex justify-between items-center'>
			<a
				href={postUrl}
				class='flex justify-center items-center dark:text-white rounded-full hover:translate-x-1 transition-transform duration-150 ease-in-out font-semibold gap-1 group'
				aria-label={`go to ${title}`}
			>
				Read Post <span
					class='mt-[1px] group-hover:rotate-45 transition-transform duration-250 ease-in-out'
					><ArrowUp width='18' height='18' /></span
				>
			</a>
		</footer>
	</div>
</article>
