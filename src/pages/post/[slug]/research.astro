---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout'
import Code from '@/components/mdx/Code'
import { DEFAULT_LOCALE, getPostLocale, getPostSlug, withBase } from '@/utils'

type Props = {
	post: CollectionEntry<'blog'>
	research: CollectionEntry<'articleResearch'>
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((post) => getPostLocale(post) === DEFAULT_LOCALE)
	const researchEntries = await getCollection('articleResearch')
	const researchBySlug = new Map(researchEntries.map((entry) => [getPostSlug(entry), entry]))

	return posts
		.map((post) => {
			const slug = getPostSlug(post)
			const research = researchBySlug.get(slug)
			if (!research || post.data.draft) return null
			return {
				params: { slug },
				props: { post, research }
			}
		})
		.filter((path): path is { params: { slug: string }; props: Props } => path !== null)
}

const { post, research } = Astro.props
const postSlug = getPostSlug(post)
const { Content } = await render(research)
const title = `${post.data.title}の調査プロセス`
---

<BaseLayout title={title} description={post.data.description} image={post.data.heroImage?.src}>
	<article class='mx-auto grid max-w-3xl gap-8 py-4'>
		<header class='grid gap-4 border-b border-black/10 pb-6 dark:border-white/10'>
			<a
				href={withBase(`/post/${postSlug}/`)}
				class='w-fit text-sm font-semibold text-gray-700 underline-offset-4 hover:underline dark:text-gray-200'
			>
				記事本文へ戻る
			</a>
			<div class='grid gap-2'>
				<p
					class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
				>
					Research Trail
				</p>
				<h1
					class='text-3xl font-semibold leading-tight text-gray-950 dark:text-gray-50 md:text-5xl'
				>
					{title}
				</h1>
				<p class='leading-7 text-gray-700 dark:text-gray-300'>
					この記事を作るために確認した問い、根拠、判断の流れを公開可能な範囲でまとめた記録です。
				</p>
			</div>
		</header>

		<div
			class='prose prose-base max-w-none dark:prose-invert md:prose-lg prose-p:leading-8 prose-li:leading-8'
		>
			<Content components={{ pre: Code }} />
		</div>
	</article>
</BaseLayout>
