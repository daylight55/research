<!-- Diagrams are generated at build time. JavaScript only enables enlargement. -->
<dialog class='diagram-dialog' data-diagram-dialog>
	<form method='dialog'><button type='submit' data-diagram-close>閉じる / Close</button></form>
	<div data-diagram-detail></div>
</dialog>

<script>
	const enableDiagramControls = () => {
		document.querySelectorAll<HTMLButtonElement>('[data-diagram-expand]').forEach((button) => {
			button.hidden = false
		})
	}
	const closeDiagram = () => {
		document.querySelector<HTMLDialogElement>('[data-diagram-dialog]')?.close()
	}
	let diagramTrigger: HTMLButtonElement | undefined
	const setupDiagramDialog = () => {
		const dialog = document.querySelector<HTMLDialogElement>('[data-diagram-dialog]')
		if (!dialog || dialog.dataset.initialized) return
		dialog.dataset.initialized = 'true'
		dialog.addEventListener('close', () => {
			dialog.querySelector('[data-diagram-detail]')?.replaceChildren()
			diagramTrigger?.focus()
		})
		dialog.addEventListener('click', (event) => {
			if (event.target !== dialog) return
			const box = dialog.getBoundingClientRect()
			if (
				event.clientX < box.left ||
				event.clientX > box.right ||
				event.clientY < box.top ||
				event.clientY > box.bottom
			)
				dialog.close()
		})
		enableDiagramControls()
	}
	document.addEventListener('click', (event) => {
		const target = event.target
		if (!(target instanceof Element)) return
		const button = target.closest<HTMLButtonElement>('[data-diagram-expand]')
		const figure = button?.closest<HTMLElement>('.article-diagram')
		const dialog = document.querySelector<HTMLDialogElement>('[data-diagram-dialog]')
		const detail = dialog?.querySelector('[data-diagram-detail]')
		if (!button || !figure || !dialog || !detail) return
		const clone = figure.cloneNode(true) as HTMLElement
		// Scope the cloned SVG styles, markers and accessible names to the dialog.
		clone.innerHTML = clone.innerHTML.replaceAll(figure.id, `${figure.id}-zoom`)
		clone.id = `${figure.id}-zoom`
		clone.setAttribute('aria-labelledby', `${figure.id}-zoom-title`)
		clone.querySelector('[data-diagram-expand]')?.remove()
		detail.replaceChildren(clone)
		dialog.setAttribute('aria-labelledby', `${clone.id}-title`)
		const close = dialog.querySelector<HTMLButtonElement>('[data-diagram-close]')
		if (close) close.textContent = document.documentElement.lang === 'ja' ? '閉じる' : 'Close'
		diagramTrigger = button
		dialog.showModal()
	})
	setupDiagramDialog()
	document.addEventListener('astro:page-load', setupDiagramDialog)
	document.addEventListener('astro:before-swap', closeDiagram)
</script>
