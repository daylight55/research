---
import { type CollectionEntry, getCollection, render } from 'astro:content'
import BlogPost from '@/layouts/BlogPost'
import Code from '@/components/mdx/Code'
import ListRelatedPosts from '@/components/ListRelatedPosts'
import FormattedDate from '@/components/FormattedDate'
import Share from '@/components/Share'
import TableOfContents from '@/components/TableOfContents'
import { DEFAULT_LOCALE, getPostUrl, getPosts, localizedPath } from '@/utils'
import SButton from '@/components/mdx/SButton'
import SourceNote from '@/components/mdx/SourceNote'
import Disqus from '@/components/Disqus'
import { disqusConfig } from '@/data/disqus.config'

const locale = DEFAULT_LOCALE
const posts = (await getCollection('blog')).filter((post) => post.id.split('/')[0] !== 'en')
export async function getStaticPaths() {
	const posts = await getPosts()

	return posts.map((post) => ({
		params: { slug: post.id },
		props: post
	}))
}
type Props = CollectionEntry<'blog'>

const post = Astro.props
const MAX_POSTS = 3
const getRelatedPosts = (post: Props) => {
	const lowercaseTags = post.data.tags.map((tag) => tag.toLowerCase())
	const relatedPosts = posts.filter(
		(p) => p.id !== post.id && p.data.tags.some((t) => lowercaseTags.includes(t.toLowerCase()))
	)
	return relatedPosts.slice(0, MAX_POSTS)
}

const relatedPosts = getRelatedPosts(post)

const { Content, headings, remarkPluginFrontmatter } = await render(post)
const glossaryTerms = (remarkPluginFrontmatter.glossaryTerms ?? []).slice(0, 18)

const disqusEnabled = disqusConfig.enabled
---

<BlogPost
	id={post.id}
	data={post.data}
	headings={headings}
	readTime={remarkPluginFrontmatter.minutesRead}
	locale={locale}
>
	<div
		class='grid grid-cols-1 gap-8 mt-8 lg:grid-cols-[9rem_minmax(0,1fr)_9rem] lg:justify-center lg:gap-4 xl:grid-cols-[10rem_minmax(0,56rem)_10rem] 2xl:grid-cols-[12rem_minmax(0,62rem)_12rem]'
	>
		<!-- article context -->
		<aside class='hidden lg:flex flex-col gap-6 pr-3 text-sm text-gray-600 dark:text-gray-400'>
			<div class='sticky top-24 flex flex-col gap-6 self-start'>
				<section class='flex flex-col gap-2'>
					<p
						class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'
					>
						Reports
					</p>
					<div class='flex flex-col gap-1.5 leading-snug'>
						<span>{post.data.category}</span>
						<FormattedDate date={post.data.pubDate} />
						<span>{remarkPluginFrontmatter.minutesRead}</span>
					</div>
				</section>

				<section class='flex flex-col gap-2'>
					<p
						class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'
					>
						Tags
					</p>
					<ul class='flex flex-col gap-1.5'>
						{
							post.data.tags.map((tag) => (
								<li>
									<a
										href={localizedPath(locale, `/tags/${encodeURIComponent(tag.toLowerCase())}`)}
										class='leading-snug text-gray-600 underline decoration-black/20 underline-offset-4 transition-colors hover:text-indigo-700 dark:text-gray-400 dark:decoration-white/20 dark:hover:text-indigo-300'
									>
										#{tag}
									</a>
								</li>
							))
						}
					</ul>
				</section>

				{
					glossaryTerms.length > 0 && (
						<section class='flex flex-col gap-2'>
							<p class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
								用語一覧
							</p>
							<ul class='flex flex-col gap-1.5'>
								{glossaryTerms.map((term) => (
									<li>
										<a
											href={localizedPath(locale, `/glossary/${term.slug}/`)}
											class='leading-snug text-gray-600 underline decoration-black/20 underline-offset-4 transition-colors hover:text-indigo-700 dark:text-gray-400 dark:decoration-white/20 dark:hover:text-indigo-300'
										>
											{term.label}
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}

				{
					relatedPosts.length > 0 && (
						<section class='flex flex-col gap-2'>
							<p class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
								Related
							</p>
							<ul class='flex flex-col gap-2.5'>
								{relatedPosts.map((relatedPost) => (
									<li>
										<a
											href={getPostUrl(relatedPost)}
											class='block leading-snug text-gray-600 transition-colors hover:text-indigo-700 dark:text-gray-400 dark:hover:text-indigo-300'
										>
											{relatedPost.data.title}
										</a>
									</li>
								))}
							</ul>
						</section>
					)
				}

				<Share title={post.data.title} />
			</div>
		</aside>

		<!-- post -->
		<article class='max-w-none w-full'>
			<div
				class='prose prose-base md:prose-lg dark:prose-invert mb-12 min-w-full max-w-none prose-p:leading-8 prose-li:leading-8'
			>
				<Content components={{ pre: Code, SButton, SourceNote }} />
			</div>

			<!-- related posts -->
			<footer class='lg:hidden'>
				<h2 class='font-bold text-lg dark:text-white mb-6'>Related Posts</h2>
				<ListRelatedPosts posts={relatedPosts} />
			</footer>
		</article>

		<!-- aside  -->
		<aside class='hidden lg:flex flex-col gap-6 pl-2 text-sm text-gray-600 dark:text-gray-400'>
			<div class='sticky top-24 self-start hidden lg:block transition-all duration-200'>
				{headings && headings.length > 0 && <TableOfContents {headings} />}
			</div>
		</aside>
	</div>

	{disqusEnabled && <Disqus />}
</BlogPost>

<script>
	const renderMermaid = async () => {
		const blocks = Array.from(document.querySelectorAll('pre code')).filter((code) =>
			/^(flowchart|graph|sequenceDiagram|classDiagram|stateDiagram|erDiagram|journey|gantt|pie|timeline|mindmap|quadrantChart|requirementDiagram|c4Context)\b/.test(
				(code.textContent || '').trim()
			)
		)
		if (blocks.length === 0) return

		const { default: mermaid } = await import('mermaid')
		const { renderMermaidSVG } = await import('beautiful-mermaid')
		mermaid.initialize({
			startOnLoad: false,
			securityLevel: 'strict',
			htmlLabels: true,
			theme: 'base',
			look: 'classic',
			flowchart: {
				curve: 'basis',
				htmlLabels: true,
				padding: 12
			},
			themeVariables: document.documentElement.classList.contains('dark')
				? {
						background: 'transparent',
						primaryColor: '#182033',
						primaryTextColor: '#f8fafc',
						primaryBorderColor: '#64748b',
						lineColor: '#94a3b8',
						tertiaryColor: '#111827',
						fontFamily: 'Manrope, ui-sans-serif, system-ui, sans-serif',
						fontSize: '15px'
					}
				: {
						background: 'transparent',
						primaryColor: '#f8fafc',
						primaryTextColor: '#111827',
						primaryBorderColor: '#cbd5e1',
						lineColor: '#64748b',
						tertiaryColor: '#eef2ff',
						fontFamily: 'Manrope, ui-sans-serif, system-ui, sans-serif',
						fontSize: '15px'
					}
		})
		const beautifulMermaidPattern =
			/^(flowchart|graph|sequenceDiagram|classDiagram|stateDiagram|stateDiagram-v2|erDiagram|xychart-beta)\b/
		const beautifulMermaidTheme = document.documentElement.classList.contains('dark')
			? {
					bg: '#0f172a',
					fg: '#f8fafc',
					line: '#94a3b8',
					accent: '#38bdf8',
					muted: '#cbd5e1',
					surface: '#111827',
					border: '#64748b',
					transparent: true,
					padding: 32,
					nodeSpacing: 52,
					layerSpacing: 56,
					thoroughness: 6
				}
			: {
					bg: '#ffffff',
					fg: '#111827',
					line: '#64748b',
					accent: '#2563eb',
					muted: '#475569',
					surface: '#f8fafc',
					border: '#cbd5e1',
					transparent: true,
					padding: 32,
					nodeSpacing: 52,
					layerSpacing: 56,
					thoroughness: 6
				}
		const removeExternalFontImport = (svg) =>
			svg.replace(/@import url\('https:\/\/fonts\.googleapis\.com[^;]+;\n?/g, '')

		for (const [index, code] of blocks.entries()) {
			const pre = code.closest('pre')
			if (!pre || pre.dataset.mermaidRendered === 'true') continue

			try {
				const id = `mermaid-${index}-${crypto.randomUUID()}`
				const source = (code.textContent || '').trim()
				let svg = ''
				let renderer = 'mermaid'
				if (beautifulMermaidPattern.test(source)) {
					try {
						svg = removeExternalFontImport(renderMermaidSVG(source, beautifulMermaidTheme))
						renderer = 'beautiful-mermaid'
					} catch (error) {
						console.warn('Falling back to Mermaid renderer', error)
					}
				}
				if (!svg) {
					const rendered = await mermaid.render(id, source)
					svg = rendered.svg
				}
				const figure = document.createElement('figure')
				figure.className =
					'mermaid-figure my-8 rounded-md border border-black/10 bg-white shadow-sm dark:border-white/10 dark:bg-white/5'
				const viewport = document.createElement('div')
				viewport.className = 'mermaid-viewport'
				viewport.dataset.renderer = renderer
				viewport.dataset.diagram = source.match(/^\S+/)?.[0] || 'mermaid'
				const diagramDirection = source.match(/^(?:flowchart|graph)\s+([A-Z]{2})\b/)?.[1]
				if (diagramDirection) {
					viewport.dataset.direction = diagramDirection
					if (diagramDirection === 'TD' || diagramDirection === 'TB') {
						figure.dataset.layout = 'compact'
					}
				}
				viewport.innerHTML = svg
				const svgElement = viewport.querySelector('svg')
				if (svgElement) {
					const viewBox = svgElement.getAttribute('viewBox')?.split(/\s+/).map(Number)
					const viewBoxWidth = viewBox && viewBox.length === 4 ? viewBox[2] : 0
					const viewBoxHeight = viewBox && viewBox.length === 4 ? viewBox[3] : 0
					svgElement.removeAttribute('height')
					svgElement.setAttribute('width', '100%')
					svgElement.setAttribute('preserveAspectRatio', 'xMidYMid meet')
					svgElement.style.maxWidth = 'none'
					if (viewBoxWidth > 0) {
						svgElement.style.setProperty(
							'--mermaid-intrinsic-width',
							`${Math.ceil(Math.min(viewBoxWidth, 1280))}px`
						)
					}
					if (viewBoxWidth > 0 && viewBoxHeight / viewBoxWidth > 1.15) {
						viewport.dataset.aspect = 'portrait'
						figure.dataset.layout = 'compact'
					}
				}
				figure.append(viewport)
				pre.dataset.mermaidRendered = 'true'
				pre.replaceWith(figure)
			} catch (error) {
				console.warn('Failed to render Mermaid diagram', error)
			}
		}
	}

	renderMermaid()
	document.addEventListener('astro:after-swap', renderMermaid)
</script>
