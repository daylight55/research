---
import BaseLayout from '@/layouts/BaseLayout'
import ArticleArchive from '@/components/ArticleArchive'
import { getReportPosts } from '@/utils'

const locale = 'en'
const posts = await getReportPosts(undefined, locale)
---

<BaseLayout title='Reports' locale={locale}>
	<header class='archive-heading'>
		<h1>Reports</h1>
		<p>Explore research by country, topic and publication date.</p>
	</header>
	<ArticleArchive posts={posts} locale={locale} section='reports' />
</BaseLayout>
