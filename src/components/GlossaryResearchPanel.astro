---
import type { GlossaryIndexTerm } from '@/utils/glossary'

type Props = {
	term: GlossaryIndexTerm
	locale: 'ja' | 'en'
}

const { term, locale } = Astro.props
const profile = term.researchProfile
const externalReference = term.externalReference
const isEnglish = locale === 'en'
const sourceKindLabel = (kind: string) => {
	const labels = {
		official: isEnglish ? 'Official' : 'Official',
		standard: isEnglish ? 'Standard' : 'Standard',
		paper: isEnglish ? 'Paper' : 'Paper',
		reference: isEnglish ? 'Reference' : 'Reference',
		wikipedia: 'Wikipedia'
	}
	return labels[kind as keyof typeof labels] ?? kind
}
const externalReferenceLabel = isEnglish ? 'External Reference' : '外部参照'
---

<section class='grid gap-5 rounded-md border border-black/10 bg-white/70 p-5 dark:border-white/10 dark:bg-white/5'>
	<div class='grid gap-2'>
		<p class='text-xs font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'>
			Definition
		</p>
		<p class='text-lg leading-8 text-gray-900 dark:text-gray-100'>{profile.definition}</p>
	</div>

	<div class='grid gap-5 md:grid-cols-2'>
		<div class='grid content-start gap-2'>
			<h2 class='text-xs font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'>
				Background
			</h2>
			<p class='text-sm leading-7 text-gray-700 dark:text-gray-300'>{profile.background}</p>
		</div>
		<div class='grid content-start gap-2'>
			<h2 class='text-xs font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'>
				Position
			</h2>
			<p class='text-sm leading-7 text-gray-700 dark:text-gray-300'>{profile.position}</p>
		</div>
	</div>

	{
		profile.distinctions.length > 0 && (
			<div class='grid gap-2'>
				<h2 class='text-xs font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'>
					Distinctions
				</h2>
				<ul class='grid gap-2'>
					{profile.distinctions.map((distinction) => (
						<li class='text-sm leading-7 text-gray-700 dark:text-gray-300'>{distinction}</li>
					))}
				</ul>
			</div>
		)
	}

	<div class='grid gap-3 border-t border-black/10 pt-4 dark:border-white/10'>
		<div class='flex flex-wrap items-center gap-2'>
			<span class='text-xs font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'>
				{externalReferenceLabel}
			</span>
			{
				externalReference ? (
					<a
						href={externalReference.url}
						target='_blank'
						rel='noopener noreferrer'
						class='text-sm font-semibold text-indigo-700 underline decoration-black/20 underline-offset-4 hover:text-indigo-900 dark:text-indigo-300 dark:decoration-white/20 dark:hover:text-indigo-100'
					>
						{externalReference.title}
					</a>
				) : (
					<span class='rounded-md bg-black/[0.04] px-2 py-1 text-xs font-semibold text-gray-600 dark:bg-white/10 dark:text-gray-300'>
						{isEnglish ? 'Not linked' : 'リンクなし'}
					</span>
				)
			}
			{
				externalReference && (
					<span class='rounded-md bg-black/[0.04] px-2 py-1 text-xs font-semibold uppercase tracking-[0.08em] text-gray-600 dark:bg-white/10 dark:text-gray-300'>
						{sourceKindLabel(externalReference.kind)}
					</span>
				)
			}
		</div>
		<p class='text-xs leading-6 text-gray-500 dark:text-gray-400'>
			{
				externalReference?.reason ??
					(isEnglish
						? 'Primary source-backed reference selected for this concept.'
						: 'この概念に対して、一次情報または外部出典を優先して参照先にしています。')
			}
		</p>
	</div>

	{
		profile.sources.length > 0 && (
			<div class='grid gap-3 border-t border-black/10 pt-4 dark:border-white/10'>
				<h2 class='text-xs font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'>
					Sources
				</h2>
				<ul class='grid gap-2'>
					{profile.sources.map((source) => (
						<li class='grid gap-1 rounded-md bg-black/[0.03] p-3 dark:bg-white/[0.04]'>
							<a
								href={source.url}
								target='_blank'
								rel='noopener noreferrer'
								class='text-sm font-semibold text-indigo-700 underline decoration-black/20 underline-offset-4 hover:text-indigo-900 dark:text-indigo-300 dark:decoration-white/20 dark:hover:text-indigo-100'
							>
								{source.title}
							</a>
							<span class='text-xs font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'>
								{sourceKindLabel(source.kind)}
							</span>
						</li>
					))}
				</ul>
			</div>
		)
	}
</section>
