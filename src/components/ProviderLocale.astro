---
const basePath = import.meta.env.BASE_URL ?? '/'
---

<script define:vars={{ basePath }}>
	const STORAGE_KEY = 'preferredLocale'
	const SCROLL_KEY = 'localeSwitchScroll'
	const DEFAULT_LOCALE = 'ja'
	const SUPPORTED_LOCALES = ['ja', 'en']

	const normalizeBase = (value) => {
		if (!value || value === '/') return ''
		return value.endsWith('/') ? value.slice(0, -1) : value
	}

	const base = normalizeBase(basePath)

	const withoutBase = (pathname) => {
		if (!base) return pathname
		if (pathname === base) return '/'
		return pathname.startsWith(`${base}/`) ? pathname.slice(base.length) : pathname
	}

	const withBase = (pathname) => `${base}${pathname}` || '/'

	const normalizePath = (pathname) => {
		const normalized = pathname.startsWith('/') ? pathname : `/${pathname}`
		return normalized.endsWith('/') ? normalized : `${normalized}/`
	}

	const getPathLocale = (pathname) => {
		const normalized = normalizePath(withoutBase(pathname))
		return normalized === '/en/' || normalized.startsWith('/en/') ? 'en' : DEFAULT_LOCALE
	}

	const stripLocale = (pathname) => {
		const normalized = normalizePath(withoutBase(pathname))
		return normalized === '/en/' ? '/' : normalized.replace(/^\/en\//, '/')
	}

	const getStoredLocale = () => {
		try {
			const stored = window.localStorage.getItem(STORAGE_KEY)
			return SUPPORTED_LOCALES.includes(stored) ? stored : undefined
		} catch {
			return undefined
		}
	}

	const setStoredLocale = (locale) => {
		if (!SUPPORTED_LOCALES.includes(locale)) return

		try {
			window.localStorage.setItem(STORAGE_KEY, locale)
		} catch {
			// Ignore unavailable storage and keep language selection URL-based.
		}
	}

	const getScrollableHeight = () =>
		Math.max(
			document.documentElement.scrollHeight,
			document.body?.scrollHeight ?? 0,
			document.documentElement.clientHeight
		)

	const saveScrollPosition = (targetLocale) => {
		try {
			const maxScroll = Math.max(1, getScrollableHeight() - window.innerHeight)
			window.sessionStorage.setItem(
				SCROLL_KEY,
				JSON.stringify({
					locale: targetLocale,
					path: stripLocale(window.location.pathname),
					y: window.scrollY,
					ratio: window.scrollY / maxScroll,
					time: Date.now()
				})
			)
		} catch {
			// Ignore unavailable storage; navigation still works normally.
		}
	}

	const restoreScrollPosition = () => {
		let saved

		try {
			const raw = window.sessionStorage.getItem(SCROLL_KEY)
			if (!raw) return
			saved = JSON.parse(raw)
			window.sessionStorage.removeItem(SCROLL_KEY)
		} catch {
			return
		}

		if (!saved || Date.now() - saved.time > 10000) return
		if (saved.locale !== getPathLocale(window.location.pathname)) return
		if (saved.path !== stripLocale(window.location.pathname)) return

		const scrollWithoutSmooth = () => {
			const maxScroll = Math.max(0, getScrollableHeight() - window.innerHeight)
			const targetY = Math.min(saved.y ?? maxScroll * (saved.ratio ?? 0), maxScroll)
			const root = document.documentElement
			const previousBehavior = root.style.scrollBehavior

			root.style.scrollBehavior = 'auto'
			window.scrollTo({ top: targetY, left: 0, behavior: 'instant' })
			root.style.scrollBehavior = previousBehavior
		}

		scrollWithoutSmooth()
		window.requestAnimationFrame(scrollWithoutSmooth)
		window.setTimeout(scrollWithoutSmooth, 80)
	}

	const canRedirectToEnglish = (contentPath) => {
		if (contentPath === '/') return true
		if (['/news/', '/reports/', '/reference/', '/tags/'].includes(contentPath)) return true
		return (
			contentPath.startsWith('/post/') ||
			contentPath.startsWith('/category/') ||
			contentPath.startsWith('/tags/')
		)
	}

	const localizedPath = (locale, contentPath) => {
		const normalized = normalizePath(contentPath)
		return locale === DEFAULT_LOCALE ? normalized : `/en${normalized}`
	}

	const syncLocale = () => {
		const currentLocale = getPathLocale(window.location.pathname)
		const contentPath = stripLocale(window.location.pathname)

		if (currentLocale === 'en') {
			setStoredLocale('en')
			return
		}

		const preferredLocale = getStoredLocale() ?? DEFAULT_LOCALE
		if (preferredLocale !== 'en' || !canRedirectToEnglish(contentPath)) return

		const targetPath = withBase(localizedPath('en', contentPath))
		const target = `${targetPath}${window.location.search}${window.location.hash}`
		window.location.replace(target)
	}

	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return

		const switchLink = event.target.closest('a[data-locale-switch]')
		if (!(switchLink instanceof HTMLAnchorElement)) return

		const targetLocale = switchLink.dataset.localeSwitch
		setStoredLocale(targetLocale)

		const targetUrl = new URL(switchLink.href, window.location.href)
		if (targetUrl.href === window.location.href) {
			event.preventDefault()
			return
		}

		saveScrollPosition(targetLocale)
	})

	window.addEventListener('pagereveal', restoreScrollPosition)
	document.addEventListener('DOMContentLoaded', restoreScrollPosition)
	document.addEventListener('astro:page-load', () => {
		restoreScrollPosition()
		syncLocale()
	})
	syncLocale()
</script>
