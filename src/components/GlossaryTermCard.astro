---
import { Image } from 'astro:assets'
import type { GlossaryIndexTerm } from '@/utils/glossary'

type Props = {
	term: GlossaryIndexTerm
	href: string
	meta: string
}

const { term, href, meta } = Astro.props
---

<li
	class='grid min-h-full overflow-hidden rounded-md border border-black/10 bg-white/70 dark:border-white/10 dark:bg-white/5'
>
	{
		term.image && (
			<a href={href} class='block aspect-[16/9] overflow-hidden bg-black/5 dark:bg-white/5'>
				<Image
					src={term.image}
					width={640}
					height={360}
					format='webp'
					loading='lazy'
					decoding='async'
					class='h-full w-full object-cover transition-transform duration-200 hover:scale-[1.015]'
					alt={term.imageAlt ?? term.label}
				/>
			</a>
		)
	}
	<div class='grid content-start gap-3 p-4'>
		<a
			href={href}
			class='font-semibold text-indigo-700 underline decoration-black/20 underline-offset-4 hover:text-indigo-900 dark:text-indigo-300 dark:decoration-white/20 dark:hover:text-indigo-100'
		>
			{term.label}
		</a>
		<p class='text-sm text-gray-600 dark:text-gray-400'>{meta}</p>
		<p class='text-sm leading-6 text-gray-700 dark:text-gray-300'>{term.explanation}</p>
	</div>
</li>
