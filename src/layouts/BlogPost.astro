---
import type { CollectionEntry } from 'astro:content'
import FormattedDate from '@/components/FormattedDate'
import TableOfContents from '@/components/TableOfContents'
import BaseLayout from '@/layouts/BaseLayout'
import type { MarkdownHeading } from 'astro'
import { Image } from 'astro:assets'
import { DEFAULT_LOCALE, localizedPath, type Locale } from '@/utils'
import { getCategoryLabel } from '@/data/categoryLabels'

type Props = {
	id: CollectionEntry<'blog'>['id']
	data: CollectionEntry<'blog'>['data']
	headings: MarkdownHeading[]
	readTime: string
	locale?: Locale
}
const { data, readTime, headings, locale = DEFAULT_LOCALE } = Astro.props
const {
	title,
	description,
	pubDate,
	heroImage,
	heroImageAlt,
	heroImageCredit,
	heroImageCreditUrl,
	contentType,
	category
} = data
const ja = locale === 'ja'
const section = contentType === 'news' ? 'news' : 'reports'
const sectionName = contentType === 'news' ? 'News' : 'Reports'
const displayTitle = contentType === 'news' ? title.replace(/^\d{4}-\d{2}-\d{2}\s+/, '') : title
const readingTime = ja ? readTime?.replace(/(\d+) min read/, '約$1分') : readTime
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage?.src}
	articleDate={pubDate.toISOString()}
	locale={locale}
>
	<article class='reading-page'>
		<nav class='article-breadcrumb' aria-label={ja ? 'パンくず' : 'Breadcrumb'}>
			<a href={localizedPath(locale, '/')}>Home</a><span aria-hidden='true'>/</span>
			<a href={localizedPath(locale, `/${section}/`)}>{sectionName}</a><span aria-hidden='true'
				>/</span
			>
			<span>{getCategoryLabel(category, locale)}</span>
		</nav>
		<header class='article-heading'>
			<div class='article-heading-copy'>
				<p class='article-dateline'>
					<span
						>{
							contentType === 'news'
								? ja
									? 'ニュース'
									: 'News'
								: ja
									? '調査レポート'
									: 'Research report'
						}</span
					><FormattedDate date={pubDate} locale={locale} />{
						readingTime && <span>{readingTime}</span>
					}
				</p>
				<h1>{displayTitle}</h1>
				<p class='article-description'>{description}</p>
			</div>
			{
				heroImage && (
					<figure class='article-hero'>
						<Image
							src={heroImage}
							width={640}
							height={420}
							format='webp'
							loading='eager'
							fetchpriority='high'
							alt={heroImageAlt ?? ''}
						/>
						{heroImageCredit && (
							<figcaption>
								{heroImageCreditUrl ? (
									<a href={heroImageCreditUrl} target='_blank' rel='noreferrer'>
										{heroImageCredit}
									</a>
								) : (
									heroImageCredit
								)}
							</figcaption>
						)}
					</figure>
				)
			}
		</header>
		{
			headings.some((heading) => heading.depth > 1) && (
				<details class='mobile-toc'>
					<summary>{ja ? '目次' : 'On this page'}</summary>
					<TableOfContents headings={headings} locale={locale} />
				</details>
			)
		}
		<slot />
	</article>
</BaseLayout>
<script>
	let tocObserver: IntersectionObserver | undefined
	const initToc = () => {
		tocObserver?.disconnect()
		const headings = [
			...document.querySelectorAll<HTMLElement>('.article-prose h2[id], .article-prose h3[id]')
		]
		const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')]
		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries.find((entry) => entry.isIntersecting)
				if (!visible) return
				for (const link of links) {
					if (decodeURIComponent(link.hash.slice(1)) === visible.target.id)
						link.setAttribute('aria-current', 'location')
					else link.removeAttribute('aria-current')
				}
			},
			{ rootMargin: '-10% 0px -65% 0px', threshold: 0 }
		)
		tocObserver = observer
		headings.forEach((heading) => observer.observe(heading))
		document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true })
	}
	initToc()
	document.addEventListener('astro:page-load', initToc)
</script>
