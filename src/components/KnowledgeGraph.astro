---
type GraphNode = {
	id: string
	label: string
	description?: string
	href?: string
	kind?: 'term' | 'post'
}

type GraphEdge = {
	id: string
	source: string
	target: string
	weight?: number
}

type Props = {
	id: string
	nodes: GraphNode[]
	edges: GraphEdge[]
	caption: string
}

const { id, nodes, edges, caption } = Astro.props
const graphData = JSON.stringify({ nodes, edges })
---

<figure class='knowledge-graph my-8 overflow-hidden rounded-md border'>
	<div id={id} class='knowledge-graph__canvas' data-knowledge-graph></div>
	<script type='application/json' id={`${id}-data`} data-graph={graphData}></script>
	<figcaption class='knowledge-graph__caption px-4 py-3 text-sm'>
		{caption}
	</figcaption>
</figure>

<style>
	.knowledge-graph {
		--graph-cyan: 34, 211, 238;
		--graph-pink: 244, 114, 182;
		--graph-yellow: 250, 204, 21;
		position: relative;
		isolation: isolate;
		border-color: rgba(var(--graph-cyan), 0.54);
		background:
			linear-gradient(rgba(var(--graph-cyan), 0.16) 1px, transparent 1px),
			linear-gradient(90deg, rgba(var(--graph-cyan), 0.16) 1px, transparent 1px),
			linear-gradient(rgba(var(--graph-cyan), 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(var(--graph-cyan), 0.045) 1px, transparent 1px),
			linear-gradient(135deg, rgba(var(--graph-pink), 0.16), transparent 28%),
			linear-gradient(315deg, rgba(var(--graph-yellow), 0.08), transparent 32%), #02050b;
		background-size:
			40px 40px,
			40px 40px,
			8px 8px,
			8px 8px,
			auto,
			auto,
			auto;
		box-shadow:
			0 0 0 1px rgba(var(--graph-pink), 0.26),
			0 24px 70px rgba(2, 6, 23, 0.36),
			inset 0 0 0 1px rgba(var(--graph-cyan), 0.24),
			inset 0 0 44px rgba(var(--graph-cyan), 0.14);
		color-scheme: dark;
	}

	.knowledge-graph::before {
		position: absolute;
		inset: 12px;
		z-index: 0;
		pointer-events: none;
		content: '';
		background:
			linear-gradient(rgba(var(--graph-cyan), 0.74), rgba(var(--graph-cyan), 0.74)) left top / 58px
				1px no-repeat,
			linear-gradient(rgba(var(--graph-cyan), 0.74), rgba(var(--graph-cyan), 0.74)) left top / 1px
				58px no-repeat,
			linear-gradient(rgba(var(--graph-cyan), 0.74), rgba(var(--graph-cyan), 0.74)) right top / 58px
				1px no-repeat,
			linear-gradient(rgba(var(--graph-cyan), 0.74), rgba(var(--graph-cyan), 0.74)) right top / 1px
				58px no-repeat,
			linear-gradient(rgba(var(--graph-pink), 0.72), rgba(var(--graph-pink), 0.72)) left bottom /
				58px 1px no-repeat,
			linear-gradient(rgba(var(--graph-pink), 0.72), rgba(var(--graph-pink), 0.72)) left bottom /
				1px 58px no-repeat,
			linear-gradient(rgba(var(--graph-yellow), 0.58), rgba(var(--graph-yellow), 0.58)) right
				bottom / 58px 1px no-repeat,
			linear-gradient(rgba(var(--graph-yellow), 0.58), rgba(var(--graph-yellow), 0.58)) right
				bottom / 1px 58px no-repeat;
		opacity: 0.84;
	}

	.knowledge-graph::after {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		content: '';
		background:
			repeating-linear-gradient(0deg, transparent 0 5px, rgba(148, 163, 184, 0.09) 5px 6px),
			linear-gradient(90deg, transparent, rgba(var(--graph-cyan), 0.18), transparent),
			linear-gradient(180deg, rgba(var(--graph-yellow), 0.09), transparent 24%);
		opacity: 0.76;
	}

	.knowledge-graph__canvas {
		position: relative;
		z-index: 1;
		min-height: clamp(22rem, 56vw, 34rem);
		background: transparent;
	}

	.knowledge-graph__canvas::before {
		position: absolute;
		inset: 18px;
		z-index: 0;
		pointer-events: none;
		content: '';
		border: 1px solid rgba(var(--graph-cyan), 0.16);
		background:
			linear-gradient(
				90deg,
				transparent 0 49%,
				rgba(var(--graph-cyan), 0.28) 49% 51%,
				transparent 51%
			),
			linear-gradient(
				0deg,
				transparent 0 49%,
				rgba(var(--graph-cyan), 0.18) 49% 51%,
				transparent 51%
			);
	}

	.knowledge-graph__caption {
		position: relative;
		z-index: 1;
		border-top: 1px solid rgba(var(--graph-cyan), 0.38);
		background: rgba(2, 6, 23, 0.92);
		color: rgb(165, 243, 252);
		font-family: 'Manrope', ui-sans-serif, system-ui, sans-serif;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
</style>

<script>
	let cytoscapeLoader

	const loadCytoscape = async () => {
		cytoscapeLoader ??= import('cytoscape').then((module) => module.default)
		return cytoscapeLoader
	}

	const hashString = (value) => {
		let hash = 0
		for (let index = 0; index < value.length; index += 1) {
			hash = (hash * 31 + value.charCodeAt(index)) >>> 0
		}
		return hash
	}

	const getStablePositions = (nodes) => {
		const center = { x: 0, y: 0 }
		if (nodes.length === 0) return new Map()
		if (nodes.length === 1) return new Map([[nodes[0].id, center]])

		const positions = new Map([[nodes[0].id, center]])
		const relatedNodes = nodes.slice(1).filter((node) => (node.kind ?? 'term') !== 'post')
		const postNodes = nodes.slice(1).filter((node) => (node.kind ?? 'term') === 'post')
		const hasHub = relatedNodes.length + postNodes.length === nodes.length - 1

		if (!hasHub || nodes.length > 18) {
			const columns = Math.ceil(Math.sqrt(nodes.length))
			const spacing = 132
			const offsetX = ((columns - 1) * spacing) / 2
			nodes
				.slice()
				.sort((a, b) => hashString(a.id) - hashString(b.id) || a.id.localeCompare(b.id))
				.forEach((node, index) => {
					positions.set(node.id, {
						x: (index % columns) * spacing - offsetX,
						y: Math.floor(index / columns) * spacing
					})
				})
			return positions
		}

		const placeOnRing = (ringNodes, radius, startAngle) => {
			ringNodes.forEach((node, index) => {
				const angle = startAngle + (Math.PI * 2 * index) / Math.max(ringNodes.length, 1)
				positions.set(node.id, {
					x: Math.cos(angle) * radius,
					y: Math.sin(angle) * radius
				})
			})
		}

		placeOnRing(relatedNodes, 150, -Math.PI / 2)
		placeOnRing(postNodes, 270, -Math.PI / 2 + Math.PI / Math.max(postNodes.length, 2))
		return positions
	}

	const initKnowledgeGraphs = async () => {
		const cytoscape = await loadCytoscape()
		document.querySelectorAll<HTMLElement>('[data-knowledge-graph]').forEach((container) => {
			if (container.dataset.rendered === 'true') return
			const dataScript = document.getElementById(`${container.id}-data`)
			if (!(dataScript instanceof HTMLElement) || !dataScript.dataset.graph) return

			const graph = JSON.parse(dataScript.dataset.graph)
			const positions = getStablePositions(graph.nodes)
			const hubNodeId = graph.nodes[0]?.id

			const cy = cytoscape({
				container,
				elements: [
					...graph.nodes.map((node) => ({
						data: {
							id: node.id,
							label: node.label,
							description: node.description,
							href: node.href,
							kind: node.kind ?? 'term',
							role: node.id === hubNodeId ? 'hub' : (node.kind ?? 'term')
						},
						position: positions.get(node.id)
					})),
					...graph.edges.map((edge) => ({
						data: {
							id: edge.id,
							source: edge.source,
							target: edge.target,
							weight: edge.weight ?? 1
						}
					}))
				],
				style: [
					{
						selector: 'node',
						style: {
							'background-color': '#06101d',
							'border-color': '#67e8f9',
							'border-width': 2,
							color: '#e0f2fe',
							label: 'data(label)',
							'font-family': 'Manrope, ui-sans-serif, system-ui, sans-serif',
							'font-size': 11,
							'font-weight': 800,
							height: 34,
							'overlay-opacity': 0,
							shape: 'round-rectangle',
							'shadow-blur': 20,
							'shadow-color': '#22d3ee',
							'shadow-opacity': 0.55,
							'shadow-offset-x': 0,
							'shadow-offset-y': 0,
							'text-background-color': '#020617',
							'text-background-opacity': 0,
							'text-background-padding': 2,
							'text-max-width': 112,
							'text-outline-color': '#020617',
							'text-outline-width': 3,
							'text-valign': 'center',
							'text-wrap': 'wrap',
							width: 74
						}
					},
					{
						selector: 'node[role = "hub"]',
						style: {
							'background-color': '#0f172a',
							'border-color': '#f0fdfa',
							'border-width': 3,
							color: '#f8fafc',
							height: 50,
							'shadow-blur': 30,
							'shadow-color': '#67e8f9',
							'shadow-opacity': 0.86,
							width: 92
						}
					},
					{
						selector: 'node[kind = "post"]',
						style: {
							'background-color': '#2a1022',
							'border-color': '#f472b6',
							color: '#fff1f2',
							height: 58,
							'shadow-color': '#f472b6',
							'shadow-opacity': 0.64,
							width: 90
						}
					},
					{
						selector: 'edge',
						style: {
							color: '#a5f3fc',
							'curve-style': 'bezier',
							'line-color': '#22d3ee',
							'line-opacity': 0.78,
							'overlay-opacity': 0,
							'shadow-blur': 18,
							'shadow-color': '#22d3ee',
							'shadow-opacity': 0.46,
							'target-arrow-fill': 'filled',
							'target-arrow-color': '#67e8f9',
							'target-arrow-shape': 'triangle',
							'arrow-scale': 0.9,
							width: 'mapData(weight, 1, 6, 2, 5)'
						}
					},
					{
						selector: 'node:selected',
						style: {
							'border-color': '#facc15',
							'shadow-color': '#facc15',
							'shadow-opacity': 0.8
						}
					},
					{
						selector: 'edge:selected',
						style: {
							'line-color': '#facc15',
							'target-arrow-color': '#facc15'
						}
					}
				],
				layout: {
					name: 'preset',
					fit: true,
					padding: 42
				},
				maxZoom: 2.5,
				minZoom: 0.25
			})

			cy.on('tap', 'node', (event) => {
				const href = event.target.data('href')
				if (href) window.location.href = href
			})

			cy.on('mouseover', 'node', (event) => {
				const description = event.target.data('description')
				if (description) {
					container.setAttribute('aria-label', `${event.target.data('label')}: ${description}`)
				}
			})

			requestAnimationFrame(() => {
				cy.resize()
				cy.fit(undefined, 42)
			})

			const observer = new ResizeObserver(() => {
				cy.resize()
				cy.fit(undefined, 42)
			})
			observer.observe(container)

			document.addEventListener(
				'astro:before-swap',
				() => {
					observer.disconnect()
					cy.destroy()
				},
				{ once: true }
			)

			container.dataset.rendered = 'true'
		})
	}

	initKnowledgeGraphs()
	document.addEventListener('astro:after-swap', initKnowledgeGraphs)
</script>
