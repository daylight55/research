---
import HeaderLink from '@/components/HeaderLink'
import LocaleToggle from '@/components/LocaleToggle'
import MenuIcon from './icons/MenuIcon.astro'
import Search from '@/components/Search'
import ToggleTheme from './ToggleTheme.astro'
import { DEFAULT_LOCALE, localizedPath, type Locale } from '@/utils'
const { locale = DEFAULT_LOCALE } = Astro.props as { locale?: Locale }
const links = [
	{ href: '/news/', label: 'News' },
	{ href: '/reports/', label: 'Reports' },
	{ href: '/reference/', label: 'Reference' },
	{ href: '/glossary/', label: 'Glossary' },
	{ href: '/tags/', label: 'Tags' }
]
---

<header class='site-header'>
	<a class='home-link' href={localizedPath(locale, '/')}>Home</a>
	<nav
		class='desktop-navigation'
		aria-label={locale === 'ja' ? 'メインナビゲーション' : 'Main navigation'}
	>
		{
			links.map((link) => (
				<HeaderLink href={link.href} locale={locale}>
					{link.label}
				</HeaderLink>
			))
		}
	</nav>
	<div class='header-tools'>
		<div class='hidden sm:block'><LocaleToggle locale={locale} /></div>
		<Search locale={locale} />
		<ToggleTheme />
		<details class='mobile-navigation'>
			<summary
				><MenuIcon /><span class='sr-only'>{locale === 'ja' ? 'メニュー' : 'Menu'}</span></summary
			>
			<nav aria-label={locale === 'ja' ? 'モバイルナビゲーション' : 'Mobile navigation'}>
				{
					links.map((link) => (
						<HeaderLink href={link.href} locale={locale}>
							{link.label}
						</HeaderLink>
					))
				}
			</nav>
		</details>
	</div>
</header>
<script>
	document.addEventListener('click', (event) => {
		const menu = document.querySelector<HTMLDetailsElement>('.mobile-navigation')
		if (menu?.open && !menu.contains(event.target as Node)) menu.open = false
	})
	document.addEventListener('keydown', (event) => {
		const menu = document.querySelector<HTMLDetailsElement>('.mobile-navigation')
		if (event.key === 'Escape' && menu?.open) {
			menu.open = false
			menu.querySelector('summary')?.focus()
		}
	})
</script>
