---
import SunIcon from '@/components/icons/SunIcon'
import MoonIcon from '@/components/icons/MoonIcon'
---

<script>
	class ThemeToggle extends HTMLElement {
		connectedCallback() {
			const button = this.querySelector('button') as HTMLButtonElement

			if (!button || button.dataset.themeToggleReady === 'true') {
				return
			}

			button.dataset.themeToggleReady = 'true'
			button.addEventListener('click', (event) => {
				if (!(event.currentTarget instanceof HTMLButtonElement)) {
					return
				}

				const isPressed = event.currentTarget.getAttribute('aria-pressed') === 'true'
				const themeChangeEvent = new CustomEvent('theme-change', {
					detail: {
						theme: isPressed ? 'light' : 'dark'
					}
				})

				document.dispatchEvent(themeChangeEvent)
				button.setAttribute('aria-pressed', String(!isPressed))
			})
		}
	}

	if ('customElements' in window && !customElements.get('theme-toggle')) {
		customElements.define('theme-toggle', ThemeToggle)
	}
</script>

<theme-toggle class='relative block h-9 w-9 shrink-0'>
	<button
		id='toggle-theme'
		type='button'
		class='flex h-9 w-9 items-center justify-center rounded-md text-[#181713] transition-colors hover:bg-black/5 dark:text-[#f4efe4] dark:hover:bg-white/10'
		aria-label='Toggle theme'
		aria-pressed='false'
	>
		<span class='theme-toggle__sun pointer-events-none absolute'>
			<SunIcon />
		</span>

		<span class='theme-toggle__moon pointer-events-none absolute'>
			<MoonIcon />
		</span>
	</button>
</theme-toggle>

<script is:inline>
	const button = document.getElementById('toggle-theme')

	function setButtonPressed() {
		if (!(button instanceof HTMLButtonElement)) {
			return
		}

		const bodyThemeIsDark = document.documentElement.classList.contains('dark')
		button.setAttribute('aria-pressed', String(bodyThemeIsDark))
	}
	setButtonPressed()
	document.addEventListener('astro:after-swap', setButtonPressed)
</script>

<style>
	.theme-toggle__sun,
	.theme-toggle__moon {
		opacity: 0;
		transition: opacity 150ms ease;
	}

	button[aria-pressed='true'] .theme-toggle__sun,
	button[aria-pressed='false'] .theme-toggle__moon {
		opacity: 1;
	}
</style>
