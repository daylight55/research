---
import ListCategories from '@/components/ListCategories'
import ListPosts from '@/components/ListPosts'
import BaseLayout from '@/layouts/BaseLayout'
import { getNewsPosts, getReportPosts, withBase } from '@/utils'
import { REFERENCE_ITEMS } from '@/data/references'
import { siteConfig } from '@/site-config'

const latestNewsPosts = await getNewsPosts(3)
const reportPosts = await getReportPosts()
---

<BaseLayout title='Home'>
	<section
		tabindex='0'
		class='group relative z-10 border-b border-black/10 pb-3 text-sm dark:border-white/10'
	>
		<div class='grid gap-2 md:grid-cols-[1fr_auto] md:items-center'>
			<div class='flex flex-wrap items-center gap-x-3 gap-y-1'>
				<p class='font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'>
					News
				</p>
				<p class='text-gray-600 dark:text-gray-300'>最新の短報はカーソルを合わせると表示</p>
			</div>
			<div class='flex items-center gap-4'>
				<a
					href={withBase('/news/rss.xml')}
					class='font-semibold text-gray-700 underline-offset-4 hover:underline dark:text-gray-200'
				>
					RSS
				</a>
				<a
					href={withBase('/news/')}
					class='font-semibold text-gray-700 underline-offset-4 hover:underline dark:text-gray-200'
				>
					一覧 →
				</a>
			</div>
		</div>
		<div
			class='pointer-events-none absolute left-0 right-0 top-full mt-2 grid gap-3 rounded-md border border-black/10 bg-white p-4 opacity-0 shadow-lg transition group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100 dark:border-white/10 dark:bg-gray-950'
		>
			{
				latestNewsPosts.length > 0 ? (
					latestNewsPosts.map((post) => (
						<a
							href={withBase(`/post/${post.slug}/`)}
							class='grid gap-1 rounded-sm p-2 transition hover:bg-black/5 dark:hover:bg-white/10'
						>
							<div class='text-xs font-semibold uppercase tracking-[0.14em] text-gray-500 dark:text-gray-400'>
								{post.data.pubDate.toLocaleDateString('ja-JP')}
							</div>
							<div class='font-semibold text-gray-900 dark:text-gray-100'>{post.data.title}</div>
							<p class='line-clamp-2 leading-6 text-gray-700 dark:text-gray-300'>
								{post.data.rssSummary ?? post.data.description}
							</p>
						</a>
					))
				) : (
					<p class='leading-7 text-gray-700 dark:text-gray-300'>
						現在公開中のニュース記事はありません。調査方針や情報源は Reference に移しました。
					</p>
				)
			}
		</div>
	</section>

	<section class='grid gap-4 border-b border-black/10 pb-8 dark:border-white/10'>
		<p class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'>
			Personal Atlas
		</p>
		<div class='grid gap-3'>
			<h1 class='max-w-4xl text-4xl font-semibold leading-tight md:text-5xl'>
				{siteConfig.title}
			</h1>
			<p class='max-w-3xl text-lg leading-8 text-gray-700 dark:text-gray-300'>
				{siteConfig.description}
			</p>
		</div>
	</section>

	<div class='grid gap-8'>
		<section>
			<div class='mb-4 grid gap-2 md:grid-cols-[1fr_auto] md:items-end'>
				<div class='grid gap-2'>
					<p
						class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
					>
						Reports
					</p>
					<h2 class='text-2xl font-semibold'>最新レポート</h2>
				</div>
				<a
					href={withBase('/reports/rss.xml')}
					class='w-fit font-semibold text-gray-700 underline-offset-4 hover:underline dark:text-gray-200'
				>
					Report RSS
				</a>
			</div>
			<ListPosts posts={reportPosts} />
		</section>

		<div class='grid gap-4'>
			<div>
				<p
					class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
				>
					Index
				</p>
				<h2 class='text-2xl font-semibold'>調査カテゴリ</h2>
			</div>
			<div class='overflow-x-auto pb-1'>
				<ListCategories />
			</div>
		</div>

		<section class='grid gap-4'>
			<div>
				<p
					class='text-sm font-semibold uppercase tracking-[0.18em] text-gray-500 dark:text-gray-400'
				>
					Reference
				</p>
				<h2 class='text-2xl font-semibold'>基本情報・統計ソース</h2>
			</div>
			<div class='grid gap-3'>
				{
					REFERENCE_ITEMS.map((item) => (
						<a
							href={withBase(item.href)}
							class='group grid gap-4 rounded-md border border-black/10 bg-white/70 p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-black/30 hover:shadow-md dark:border-white/10 dark:bg-white/10 dark:hover:border-white/30 md:grid-cols-[1fr_auto] md:items-center'
						>
							<div class='grid gap-2'>
								<h3 class='text-xl font-semibold'>{item.title}</h3>
								<p class='max-w-3xl leading-7 text-gray-700 dark:text-gray-300'>
									{item.description}
								</p>
							</div>
							<span class='text-sm font-semibold text-gray-900 transition group-hover:translate-x-1 dark:text-gray-100'>
								開く →
							</span>
						</a>
					))
				}
			</div>
		</section>
	</div>
</BaseLayout>
