---
type GraphNode = {
	id: string
	label: string
	description?: string
	href?: string
	kind?: 'term' | 'post'
}

type GraphEdge = {
	id: string
	source: string
	target: string
	weight?: number
}

type Props = {
	id: string
	nodes: GraphNode[]
	edges: GraphEdge[]
	caption: string
}

const { id, nodes, edges, caption } = Astro.props
const graphData = JSON.stringify({ nodes, edges })
const nodeKindLabel = (kind: GraphNode['kind']) => {
	if (kind === 'post') return 'Article'
	return 'Term'
}
---

<figure
	class='knowledge-graph my-8 overflow-hidden rounded-md border border-black/10 bg-white shadow-sm dark:border-white/10 dark:bg-white/5'
>
	<div id={id} class='knowledge-graph__canvas' data-knowledge-graph></div>
	<script type='application/json' id={`${id}-data`} data-graph={graphData}></script>
	<div class='border-t border-black/10 px-4 py-4 dark:border-white/10'>
		<section class='grid gap-2'>
			<h3
				class='text-sm font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400'
			>
				Node Definitions
			</h3>
			<dl class='grid gap-3'>
				{
					nodes.map((node) => (
						<div class='grid gap-1 rounded-md bg-black/[0.03] p-3 dark:bg-white/[0.04]'>
							<dt class='flex flex-wrap items-baseline gap-2 text-sm font-semibold text-gray-900 dark:text-gray-100'>
								<span>{node.label}</span>
								<span class='text-xs font-medium uppercase tracking-[0.1em] text-gray-500 dark:text-gray-400'>
									{nodeKindLabel(node.kind)}
								</span>
							</dt>
							<dd class='text-sm leading-6 text-gray-600 dark:text-gray-400'>
								{node.description ??
									`${node.label} is a ${nodeKindLabel(node.kind).toLowerCase()} node in this concept map.`}
							</dd>
						</div>
					))
				}
			</dl>
		</section>
	</div>
	<figcaption
		class='border-t border-black/10 px-4 py-3 text-sm text-gray-600 dark:border-white/10 dark:text-gray-400'
	>
		{caption}
	</figcaption>
</figure>

<script>
	let cytoscapeLoader

	const loadCytoscape = async () => {
		cytoscapeLoader ??= import('cytoscape').then((module) => module.default)
		return cytoscapeLoader
	}

	const initKnowledgeGraphs = async () => {
		const cytoscape = await loadCytoscape()
		document.querySelectorAll<HTMLElement>('[data-knowledge-graph]').forEach((container) => {
			if (container.dataset.rendered === 'true') return
			const dataScript = document.getElementById(`${container.id}-data`)
			if (!(dataScript instanceof HTMLElement) || !dataScript.dataset.graph) return

			const graph = JSON.parse(dataScript.dataset.graph)
			const isDark = document.documentElement.classList.contains('dark')

			const cy = cytoscape({
				container,
				elements: [
					...graph.nodes.map((node) => ({
						data: {
							id: node.id,
							label: node.label,
							description: node.description,
							href: node.href,
							kind: node.kind ?? 'term'
						}
					})),
					...graph.edges.map((edge) => ({
						data: {
							id: edge.id,
							source: edge.source,
							target: edge.target,
							weight: edge.weight ?? 1
						}
					}))
				],
				style: [
					{
						selector: 'node',
						style: {
							'background-color': isDark ? '#1d4ed8' : '#3457d5',
							'border-color': isDark ? '#bfdbfe' : '#1e3a8a',
							'border-width': 2,
							color: isDark ? '#f8fafc' : '#111827',
							label: 'data(label)',
							'font-family': 'Manrope, ui-sans-serif, system-ui, sans-serif',
							'font-size': 11,
							'font-weight': 700,
							height: 48,
							'overlay-opacity': 0,
							'text-background-color': isDark ? '#111827' : '#fffdf7',
							'text-background-opacity': 0.82,
							'text-background-padding': 3,
							'text-max-width': 96,
							'text-valign': 'center',
							'text-wrap': 'wrap',
							width: 48
						}
					},
					{
						selector: 'node[kind = "post"]',
						style: {
							'background-color': isDark ? '#0f766e' : '#0d9488',
							'border-color': isDark ? '#99f6e4' : '#115e59',
							shape: 'round-rectangle',
							height: 54,
							width: 64
						}
					},
					{
						selector: 'edge',
						style: {
							color: isDark ? '#e2e8f0' : '#334155',
							'curve-style': 'bezier',
							'line-color': isDark ? '#64748b' : '#94a3b8',
							'line-opacity': 0.8,
							'overlay-opacity': 0,
							'target-arrow-color': isDark ? '#64748b' : '#94a3b8',
							'target-arrow-shape': 'triangle',
							width: 'mapData(weight, 1, 6, 1.5, 4)'
						}
					}
				],
				layout: {
					name: 'cose',
					animate: !window.matchMedia('(prefers-reduced-motion: reduce)').matches,
					animationDuration: 350,
					componentSpacing: 72,
					fit: true,
					idealEdgeLength: 112,
					nodeOverlap: 18,
					padding: 42,
					randomize: false
				},
				maxZoom: 2.5,
				minZoom: 0.25
			})

			cy.on('tap', 'node', (event) => {
				const href = event.target.data('href')
				if (href) window.location.href = href
			})

			cy.on('mouseover', 'node', (event) => {
				const description = event.target.data('description')
				if (description) {
					container.setAttribute('aria-label', `${event.target.data('label')}: ${description}`)
				}
			})

			requestAnimationFrame(() => {
				cy.resize()
				cy.fit(undefined, 42)
			})

			const observer = new ResizeObserver(() => {
				cy.resize()
				cy.fit(undefined, 42)
			})
			observer.observe(container)

			document.addEventListener(
				'astro:before-swap',
				() => {
					observer.disconnect()
					cy.destroy()
				},
				{ once: true }
			)

			container.dataset.rendered = 'true'
		})
	}

	initKnowledgeGraphs()
	document.addEventListener('astro:after-swap', initKnowledgeGraphs)
</script>
