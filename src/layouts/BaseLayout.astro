---
import BaseHead from '@/components/BaseHead'
import Header from '@/components/Header'
import Footer from '@/components/Footer'
import FloatingLocaleSwitch from '@/components/FloatingLocaleSwitch'
import ProviderTheme from '@/components/ProviderTheme'
import ProviderAnimations from '@/components/ProviderAnimations'
import ProviderLocale from '@/components/ProviderLocale'
import TwSizeIndicator from '@/components/TwSizeIndicator'
import { DEFAULT_LOCALE } from '@/utils'
const { title, description, image, articleDate, locale = DEFAULT_LOCALE } = Astro.props
const htmlLang = locale === 'mix' ? 'en' : locale
---

<html lang={htmlLang} class='scroll-smooth'>
	<head>
		<BaseHead title={title} description={description} ogImage={image} articleDate={articleDate} />
		<ProviderLocale />
		<ProviderTheme />
		<ProviderAnimations />
	</head>

	<body class='text-[#181713] dark:text-[#f4efe4]'>
		<a class='skip-link' href='#main-content'
			>{locale === 'ja' ? '本文へスキップ' : 'Skip to content'}</a
		>
		<div class='site-shell'>
			<Header locale={locale} />
			<main id='main-content' class='site-main' tabindex='-1'>
				<slot />
			</main>
			<Footer />
		</div>
		<FloatingLocaleSwitch locale={locale} />
		<TwSizeIndicator />
	</body>
</html>
