---
import type { CollectionEntry } from 'astro:content'
import PostCard from '@/components/PostCard'
import { DEFAULT_LOCALE, getPostSlug, type Locale } from '@/utils'

type Props = {
	posts: CollectionEntry<'blog'>[]
	locale?: Locale
	variant?: 'card' | 'compact'
	headingLevel?: 2 | 3
}
const { posts, locale = DEFAULT_LOCALE, variant = 'card', headingLevel = 2 } = Astro.props
---

<div class:list={['post-list', variant === 'compact' && 'post-list-compact']}>
	{
		posts.map((post) => (
			<PostCard
				data={post.data}
				slug={getPostSlug(post)}
				locale={locale}
				variant={variant}
				headingLevel={headingLevel}
			/>
		))
	}
</div>
